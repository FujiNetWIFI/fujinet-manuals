# The owner's manual's bench: its own fujinet-pc and game servers, on ports
# clear of the Programmer's Handbook's (9952/8052/87xx) and the other rigs.
FNPC_DIR=${FNPC_DIR:-$HOME/Workspace/fnpc-5200-owners}
BOIP_PORT=${BOIP_PORT:-9953}       # fujinet-pc BoIP: MAME's FUJINET_TCP
WEB_PORT=${WEB_PORT:-8053}         # fujinet-pc web UI
FCS_PORT=${FCS_PORT:-8791}         # 5 Card Stud server
TH_PORT=${TH_PORT:-8792}           # Texas Hold'em server
BS_PORT=${BS_PORT:-8793}           # Battleship server
FZ_PORT=${FZ_PORT:-8794}           # Fujitzee server
FK_PORT=${FK_PORT:-8795}           # Fujirkle server
