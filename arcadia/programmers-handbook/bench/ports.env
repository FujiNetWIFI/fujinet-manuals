# The book's bench: its own ports, clear of the other rigs (the Owner's
# Manual's 9961/8061/8781-8786, the 5200 books' 9952/876x/878x, the Studio II
# book's 9973/876x/877x, the user's long-running fujinet-pc on 9995).
# bench/ports.sh checks them before anything starts.
FNPC_DIR=${FNPC_DIR:-$HOME/Workspace/fnpc-arcadia-book}
BOIP_PORT=${BOIP_PORT:-9963}       # fujinet-pc BoIP: MAME's FUJINET_TCP
WEB_PORT=${WEB_PORT:-8063}         # fujinet-pc web UI
HTTP_PORT=${HTTP_PORT:-8790}       # the HTTP fixture (listings/fixtures)
NC_PORT=${NC_PORT:-8791}           # the netcat line server
BS_PORT=${BS_PORT:-8792}           # Battleship server
FCS_PORT=${FCS_PORT:-8793}         # 5 Card Stud server
SERVERS_REF=${SERVERS_REF:-0945622} # FujiNetWIFI/servers, the game servers
