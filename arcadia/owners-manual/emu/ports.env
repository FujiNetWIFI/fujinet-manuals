# The owner's manual's bench: its own fujinet-pc and game servers, on ports
# clear of the other rigs (the 5200 books' 9952/9953, 87xx/879x; the
# user's long-running fujinet-pc on 9995).
FNPC_DIR=${FNPC_DIR:-$HOME/Workspace/fnpc-arcadia-owners}
BOIP_PORT=${BOIP_PORT:-9961}       # fujinet-pc BoIP: MAME's FUJINET_TCP
WEB_PORT=${WEB_PORT:-8061}         # fujinet-pc web UI
FCS_PORT=${FCS_PORT:-8781}         # 5 Card Stud server
TH_PORT=${TH_PORT:-8782}           # Texas Hold'em server
BS_PORT=${BS_PORT:-8783}           # Battleship server
FZ_PORT=${FZ_PORT:-8784}           # Fujitzee server
LOBBY_PORT=${LOBBY_PORT:-8786}     # the Game Lobby server
