 "printed": [
  "                     ;       FLASHMODE - PUT THE H89 FUJINET'S ESP32 IN DOWNLOAD MODE",
  "                     ;",
  "                     ;       KEYED INTO THE MONITOR AT 040.100 AND RUN WITH G040100, FOR",
  "                     ;       MONITORS WITHOUT AN OUT COMMAND (MTR-88, MTR-89).  RESTARTS",
  "                     ;       THE ESP32 WITH IO0 LOW, SO IT WAITS FOR THE FUJINET FLASHER.",
  "                     ;       PUSH SHIFT AND RESET WHEN THE FLASHER IS DONE.",
  "                     ;",
  "                     ;       Copyright (C) 2026 Thomas Cherryhomes",
  "                     ;       SPDX-License-Identifier: GPL-3.0-or-later",
  "                     ;",
  "                     PSTAT   EQU     322Q            ;82C55 PORT C",
  "                     PCTRL   EQU     323Q            ;82C55 CONTROL WORD",
  "                     ;",
  "                             ORG     040100A",
  "                     ;",
  "040100  076 300      START:  MVI     A,300Q          ;MODE 2: EN=0 AND IO0=0",
  "040102  323 323              OUT     PCTRL",
  "040104  041 000 000          LXI     H,0             ;HOLD THE ESP32 IN RESET A WHILE",
  "040107  053          DELAY:  DCX     H",
  "040110  174                  MOV     A,H",
  "040111  265                  ORA     L",
  "040112  302 107 040          JNZ     DELAY",
  "040115  076 004              MVI     A,004Q          ;EN=1 WITH IO0=0: DOWNLOAD MODE",
  "040117  323 322              OUT     PSTAT",
  "040121  166                  HLT                     ;BACK TO THE MONITOR",
  "                     ;",
  "                             END     START"
 ]
