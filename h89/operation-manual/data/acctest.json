 "printed": [
  "                     ;       ACCTEST - H89 FUJINET ACCEPTANCE TEST",
  "                     ;",
  "                     ;       KEYED INTO THE MONITOR AT 040.100 AND RUN WITH G040100.",
  "                     ;       STARTS THE CARD, ASKS IT FOR ITS ADAPTER CONFIGURATION AND",
  "                     ;       PRINTS THE ANSWER.  PRINTS 1 WHEN THE 82C55 ANSWERS, 2 WHEN",
  "                     ;       THE ESP32 HAS TAKEN THE REQUEST, THEN THE REPLY'S TEXT.  ENDS",
  "                     ;       WITH A HALT, WHICH THE MONITOR TURNS INTO A BEEP, AN H AND",
  "                     ;       THE H: PROMPT.",
  "                     ;",
  "                     ;       NUMBERS ARE OCTAL (Q) OR SPLIT OCTAL (A), AS IN HEATH LISTINGS.",
  "                     ;",
  "                     ;       Copyright (C) 2026 Thomas Cherryhomes",
  "                     ;       SPDX-License-Identifier: GPL-3.0-or-later",
  "                     ;",
  "                     PDATA   EQU     320Q            ;82C55 PORT A, THE BYTE PIPE",
  "                     PSTAT   EQU     322Q            ;82C55 PORT C: STATUS IN, CONTROL OUT",
  "                     PCTRL   EQU     323Q            ;82C55 CONTROL WORD",
  "                     WCC     EQU     003302A         ;MONITOR: WRITE CONSOLE CHARACTER",
  "                     ;",
  "                             ORG     040100A",
  "                     ;",
  "040100  076 300      START:  MVI     A,300Q          ;PORT A MODE 2, PC0-PC2 OUT:",
  "040102  323 323              OUT     PCTRL           ; EN=0 HOLDS THE ESP32 IN RESET",
  "040104  076 006              MVI     A,006Q          ;EN=1 WITH IO0=1: BOOT FROM FLASH",
  "040106  323 322              OUT     PSTAT",
  "040110  041 000 000          LXI     H,0             ;WAIT ABOUT 3/4 SECOND SO THE",
  "040113  053          DELAY:  DCX     H               ; ESP32 LATCHES IO0 BEFORE THE",
  "040114  174                  MOV     A,H             ; 245 IS TURNED ON",
  "040115  265                  ORA     L",
  "040116  302 113 040          JNZ     DELAY",
  "040121  076 005              MVI     A,005Q          ;245 ON (/OE=0), DIR TOWARD ESP32",
  "040123  323 322              OUT     PSTAT",
  "040125  333 322              IN      PSTAT           ;IS THE 82C55 THERE?",
  "040127  346 007              ANI     007Q            ; PC2-PC0 MUST READ BACK 101",
  "040131  376 005              CPI     005Q",
  "040133  302 270 040          JNZ     DONE            ;NO: HALT NOW",
  "040136  076 061              MVI     A,'1'           ;CHECKPOINT 1",
  "040140  315 302 003          CALL    WCC",
  "040143  041 271 040          LXI     H,REQ           ;SEND THE REQUEST",
  "040146  006 010              MVI     B,8",
  "040150  176          SEND:   MOV     A,M",
  "040151  323 320              OUT     PDATA",
  "040153  333 322      WOBF:   IN      PSTAT           ;WAIT UNTIL THE ESP32 HAS IT",
  "040155  346 200              ANI     200Q            ; (/OBF HIGH AGAIN)",
  "040157  312 153 040          JZ      WOBF",
  "040162  043                  INX     H",
  "040163  005                  DCR     B",
  "040164  302 150 040          JNZ     SEND",
  "040167  076 004              MVI     A,004Q          ;DIR TOWARD THE H89",
  "040171  323 322              OUT     PSTAT",
  "040173  076 062              MVI     A,'2'           ;CHECKPOINT 2",
  "040175  315 302 003          CALL    WCC",
  "040200  001 000 005  SYNC:   LXI     B,002400Q       ;B=5 HEADER BYTES TO SKIP, C=0",
  "040203  315 256 040  HEAD:   CALL    GETB            ;FIND THE FRAME, SKIP THE HEADER",
  "040206  376 300              CPI     300Q            ; (START OVER ON EVERY C0)",
  "040210  312 200 040          JZ      SYNC",
  "040213  005                  DCR     B",
  "040214  302 203 040          JNZ     HEAD",
  "040217  315 256 040  SHOW:   CALL    GETB            ;PRINT THE REPLY UP TO THE END C0",
  "040222  376 300              CPI     300Q",
  "040224  312 270 040          JZ      DONE",
  "040227  376 041              CPI     041Q            ;PRINTABLE?",
  "040231  332 241 040          JC      GAP",
  "040234  376 177              CPI     177Q",
  "040236  332 247 040          JC      PUT",
  "040241  076 040      GAP:    MVI     A,040Q          ;ANYTHING ELSE IS A SPACE,",
  "040243  271                  CMP     C               ; BUT ONLY ONE IN A ROW",
  "040244  312 217 040          JZ      SHOW",
  "040247  117          PUT:    MOV     C,A",
  "040250  315 302 003          CALL    WCC",
  "040253  303 217 040          JMP     SHOW",
  "                     ;",
  "040256  333 322      GETB:   IN      PSTAT           ;WAIT FOR A BYTE FROM THE ESP32",
  "040260  346 040              ANI     040Q            ; (IBF HIGH)",
  "040262  312 256 040          JZ      GETB",
  "040265  333 320              IN      PDATA",
  "040267  311                  RET",
  "                     ;",
  "                     ;       THE HALT COMES LAST: THE MONITOR'S CLOCK SEES A HALT WHEN THE",
  "                     ;       BYTE BEFORE THE INTERRUPTED ADDRESS IS 166Q, SO NO CODE MAY",
  "                     ;       FOLLOW ONE.",
  "040270  166          DONE:   HLT                     ;BACK TO THE MONITOR",
  "                     ;",
  "                     ;       GET ADAPTER CONFIG (350Q) FOR THE FUJINET DEVICE (160Q),",
  "                     ;       A SIX-BYTE FUJIBUS HEADER BETWEEN SLIP END BYTES (300Q).",
  "040271  300 160 350  REQ:    DB      300Q,160Q,350Q,006Q,000Q,137Q,000Q,300Q",
  "        006 000 137",
  "        000 300    ",
  "                     ;",
  "                             END     START"
 ]
