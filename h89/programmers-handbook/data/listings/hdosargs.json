{"name": "hdosargs", "files": [{"path": "src/c/common/hdosargs.h", "lines": 26, "sha256": "4dc161162218da14d998339220a6dd102fa10db79665cfe6692a392d0724d1b1", "printed": [["   1 ", "/*"], ["   2 ", " * hdosargs.h -- the command line under HDOS."], ["   3 ", " *"], ["   4 ", " * z88dk's HDOS start-up code (hdos_crt0.asm, startup=3) picks the entry"], ["   5 ", " * stack pointer back up after it has moved the stack, so it parses the"], ["   6 ", " * command line with a wrong length and argv[] comes out damaged. Build with"], ["   7 ", " * -pragma-define:CRT_ENABLE_COMMANDLINE=0 and call hdos_args() first thing"], ["   8 ", " * in main(): it splits the command line HDOS left below 2280H into argv[]."], ["   9 ", " * Under CP/M it changes nothing."], ["  10 ", " *"], ["  11 ", " * Copyright (C) 2026 Thomas Cherryhomes"], ["  12 ", " * SPDX-License-Identifier: GPL-3.0-or-later"], ["  13 ", " */"], ["  14 ", "#ifndef HDOSARGS_H"], ["  15 ", "#define HDOSARGS_H"], ["  16 ", ""], ["  17 ", "#define HDOS_MAXARGS 16"], ["  18 ", ""], ["  19 ", "#ifdef __HDOS__"], ["  20 ", "int hdos_args(char ***argvp);"], ["  21 ", "#define ARGS(argc, argv)  ((argc) = hdos_args(&(argv)))"], ["  22 ", "#else"], ["  23 ", "#define ARGS(argc, argv)"], ["  24 ", "#endif"], ["  25 ", ""], ["  26 ", "#endif"]]}, {"path": "src/c/common/hdosargs.c", "lines": 43, "sha256": "d0fa006275a529a1629f602c6cf70e8f6f4d4bd11fbee56eb2666d1000ef2cf4", "printed": [["   1 ", "/*"], ["   2 ", " * hdosargs.c -- the command line under HDOS: see hdosargs.h."], ["   3 ", " *"], ["   4 ", " * HDOS starts a program with SP pointing at the first character of its"], ["   5 ", " * arguments; they run up to a NUL at 227FH. With no arguments SP is 2280H."], ["   6 ", " * The start-up code keeps the entry SP inside its own exit code, as the"], ["   7 ", " * operand of \"ld sp,nnnn\" at __restore_sp_onexit, so it can be read back"], ["   8 ", " * from there."], ["   9 ", " *"], ["  10 ", " * Copyright (C) 2026 Thomas Cherryhomes"], ["  11 ", " * SPDX-License-Identifier: GPL-3.0-or-later"], ["  12 ", " */"], ["  13 ", "#ifdef __HDOS__"], ["  14 ", "#include \"hdosargs.h\""], ["  15 ", ""], ["  16 ", "extern unsigned char _restore_sp_onexit[];   /* asm: __restore_sp_onexit */"], ["  17 ", ""], ["  18 ", "static char *args_v[HDOS_MAXARGS + 2];"], ["  19 ", "static char args_name[] = \"\";"], ["  20 ", ""], ["  21 ", "int hdos_args(char ***argvp)"], ["  22 ", "{"], ["  23 ", "    char *p = *(char **)(_restore_sp_onexit + 1);   /* the entry SP */"], ["  24 ", "    char *end = (char *)0x227F;"], ["  25 ", "    int n = 0;"], ["  26 ", ""], ["  27 ", "    args_v[n++] = args_name;"], ["  28 ", "    while (p < end && n <= HDOS_MAXARGS) {"], ["  29 ", "        while (p < end && *p == ' ')"], ["  30 ", "            p++;"], ["  31 ", "        if (p >= end || *p == 0)"], ["  32 ", "            break;"], ["  33 ", "        args_v[n++] = p;"], ["  34 ", "        while (p < end && *p != ' ' && *p != 0)"], ["  35 ", "            p++;"], ["  36 ", "        if (p < end && *p == ' ')"], ["  37 ", "            *p++ = 0;"], ["  38 ", "    }"], ["  39 ", "    args_v[n] = 0;"], ["  40 ", "    *argvp = args_v;"], ["  41 ", "    return n;"], ["  42 ", "}"], ["  43 ", "#endif"]]}], "total_lines": 69, "printed_lines": 69, "wrap": 95}