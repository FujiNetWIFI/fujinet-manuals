{"name": "nput-c", "files": [{"path": "src/c/nput/nput.c", "lines": 75, "sha256": "9fcf0697543b1b9453101187a1f1645578d78f7d4c4be5cf4b2c60deaf1a8b52", "printed": [["   1 ", "/*"], ["   2 ", " * NPUT -- copy a file from a disk to the network, in C. Opens the"], ["   3 ", " * devicespec on network unit 1 for writing, sends the file in pieces, and"], ["   4 ", " * closes the channel, which is when an HTTP PUT is really sent. NPUT.ASM's"], ["   5 ", " * twin."], ["   6 ", " *"], ["   7 ", " *   NPUT SY1:HELLO.TXT N:HTTP://192.168.1.10/hello.txt      (HDOS)"], ["   8 ", " *   NPUT                    (and answer; CP/M capitalises a command line)"], ["   9 ", " *"], ["  10 ", " * HDOS and CP/M know a file's length only in whole sectors and records,"], ["  11 ", " * so the copy is that long."], ["  12 ", " *"], ["  13 ", " *   tools/cc.sh hdos NPUT src/c/nput/nput.c src/c/common/words.c \\"], ["  14 ", " *       src/c/common/hdosargs.c                     ->  NPUT.ABS"], ["  15 ", " *   tools/cc.sh cpm NPUT ...the same...             ->  NPUT.COM"], ["  16 ", " *"], ["  17 ", " * Copyright (C) 2026 Thomas Cherryhomes"], ["  18 ", " * SPDX-License-Identifier: GPL-3.0-or-later"], ["  19 ", " */"], ["  20 ", "#include <stdio.h>"], ["  21 ", "#include <string.h>"], ["  22 ", "#include <fujinet-network.h>"], ["  23 ", "#include \"h89con.h\""], ["  24 ", "#include \"hdosargs.h\""], ["  25 ", "#include \"words.h\""], ["  26 ", ""], ["  27 ", "#define BUFSZ 512               /* bytes sent to the FujiNet at once */"], ["  28 ", ""], ["  29 ", "static char spec[132], fname[32];"], ["  30 ", "static uint8_t buf[BUFSZ];"], ["  31 ", ""], ["  32 ", "int main(int argc, char *argv[])"], ["  33 ", "{"], ["  34 ", "    FILE *f;"], ["  35 ", "    size_t len;"], ["  36 ", "    unsigned long total = 0;"], ["  37 ", "    int result = 0;"], ["  38 ", ""], ["  39 ", "    ARGS(argc, argv);"], ["  40 ", "    con_init(0);"], ["  41 ", "    printf(\"NPUT - copy a file to the network\\n\");"], ["  42 ", "    if (two_words(argc, argv, \"From (file): \", fname, sizeof fname,"], ["  43 ", "                  \"To (devicespec): \", spec, sizeof spec - 2) < 0) {"], ["  44 ", "        printf(\"Usage: NPUT file devicespec\\n\");"], ["  45 ", "        goto out;"], ["  46 ", "    }"], ["  47 ", "    net_spec(spec);"], ["  48 ", "    if ((f = fopen(fname, \"rb\")) == NULL) {"], ["  49 ", "        printf(\"Cannot open the file.\\n\");"], ["  50 ", "        goto out;"], ["  51 ", "    }"], ["  52 ", ""], ["  53 ", "    if (network_open(spec, 8, 0) != FN_ERR_OK) {    /* write, no translation */"], ["  54 ", "        printf(\"The FujiNet could not open that.\\n\");"], ["  55 ", "        fclose(f);"], ["  56 ", "        goto out;"], ["  57 ", "    }"], ["  58 ", ""], ["  59 ", "    while ((len = fread(buf, 1, BUFSZ, f)) > 0) {"], ["  60 ", "        if (network_write(spec, buf, len) != FN_ERR_OK) {"], ["  61 ", "            printf(\"Network error; the copy may be incomplete.\\n\");"], ["  62 ", "            result = 1;"], ["  63 ", "            break;"], ["  64 ", "        }"], ["  65 ", "        total += len;"], ["  66 ", "    }"], ["  67 ", ""], ["  68 ", "    network_close(spec);                            /* an HTTP PUT goes now */"], ["  69 ", "    fclose(f);"], ["  70 ", "    if (!result)"], ["  71 ", "        printf(\"%lu bytes sent.\\n\", total);"], ["  72 ", "out:"], ["  73 ", "    con_exit();"], ["  74 ", "    return result;"], ["  75 ", "}"]]}], "total_lines": 75, "printed_lines": 75, "wrap": 95}