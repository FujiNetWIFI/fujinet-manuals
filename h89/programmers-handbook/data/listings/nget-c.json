{"name": "nget-c", "files": [{"path": "src/c/nget/nget.c", "lines": 98, "sha256": "9ddd26747d6d3ee4901cac534e90fa6f2da3fae0255040bb14bea0d081eb1376", "printed": [["   1 ", "/*"], ["   2 ", " * NGET -- copy a file from the network to a disk, in C. Opens the"], ["   3 ", " * devicespec on network unit 1 for reading and writes whatever comes to"], ["   4 ", " * the file, until the FujiNet says the end has been reached. NGET.ASM's"], ["   5 ", " * twin."], ["   6 ", " *"], ["   7 ", " *   NGET N:HTTP://192.168.1.10/hello.txt SY1:HELLO.TXT      (HDOS)"], ["   8 ", " *   NGET                    (and answer; CP/M capitalises a command line)"], ["   9 ", " *"], ["  10 ", " * HDOS and CP/M keep files in whole sectors and records, so the copy ends"], ["  11 ", " * with up to a sector of zeros, or a record of CTRL-Z, after the data."], ["  12 ", " *"], ["  13 ", " *   tools/cc.sh hdos NGET src/c/nget/nget.c src/c/common/words.c \\"], ["  14 ", " *       src/c/common/hdosargs.c                     ->  NGET.ABS"], ["  15 ", " *   tools/cc.sh cpm NGET ...the same...             ->  NGET.COM"], ["  16 ", " *"], ["  17 ", " * Copyright (C) 2026 Thomas Cherryhomes"], ["  18 ", " * SPDX-License-Identifier: GPL-3.0-or-later"], ["  19 ", " */"], ["  20 ", "#include <stdio.h>"], ["  21 ", "#include <string.h>"], ["  22 ", "#include <fujinet-network.h>"], ["  23 ", "#include \"h89con.h\""], ["  24 ", "#include \"hdosargs.h\""], ["  25 ", "#include \"words.h\""], ["  26 ", ""], ["  27 ", "#define BUFSZ     512           /* bytes taken from the FujiNet at once */"], ["  28 ", "#define EOF_ERR   136           /* STATUS error: the end of the data */"], ["  29 ", "#define WAIT_SECS 30            /* give up after this long with nothing */"], ["  30 ", ""], ["  31 ", "static char spec[132], fname[32];"], ["  32 ", "static uint8_t buf[BUFSZ];"], ["  33 ", ""], ["  34 ", "int main(int argc, char *argv[])"], ["  35 ", "{"], ["  36 ", "    FILE *f;"], ["  37 ", "    uint16_t avail, len, last;"], ["  38 ", "    uint8_t connected, err;"], ["  39 ", "    unsigned long total = 0;"], ["  40 ", "    int result = 0;"], ["  41 ", ""], ["  42 ", "    ARGS(argc, argv);"], ["  43 ", "    con_init(0);"], ["  44 ", "    printf(\"NGET - copy a file from the network\\n\");"], ["  45 ", "    if (two_words(argc, argv, \"From (devicespec): \", spec, sizeof spec - 2,"], ["  46 ", "                  \"To (file): \", fname, sizeof fname) < 0) {"], ["  47 ", "        printf(\"Usage: NGET devicespec file\\n\");"], ["  48 ", "        goto out;"], ["  49 ", "    }"], ["  50 ", "    net_spec(spec);"], ["  51 ", ""], ["  52 ", "    if (network_open(spec, 4, 0) != FN_ERR_OK) {    /* read, no translation */"], ["  53 ", "        printf(\"The FujiNet could not open that.\\n\");"], ["  54 ", "        goto out;"], ["  55 ", "    }"], ["  56 ", "    if ((f = fopen(fname, \"wb\")) == NULL) {"], ["  57 ", "        printf(\"Cannot create the file.\\n\");"], ["  58 ", "        network_close(spec);"], ["  59 ", "        goto out;"], ["  60 ", "    }"], ["  61 ", ""], ["  62 ", "    last = TICKS;"], ["  63 ", "    for (;;) {"], ["  64 ", "        if (network_status(spec, &avail, &connected, &err) != FN_ERR_OK"], ["  65 ", "            || (avail == 0 && err > 1 && err != EOF_ERR)) {"], ["  66 ", "            printf(\"Network error %u\\n\", err);"], ["  67 ", "            result = 1;"], ["  68 ", "            break;"], ["  69 ", "        }"], ["  70 ", "        if (avail == 0) {"], ["  71 ", "            if (err == EOF_ERR || !connected)       /* the end */"], ["  72 ", "                break;"], ["  73 ", "            if ((uint16_t)(TICKS - last) > WAIT_SECS * TICKS_PER_SECOND) {"], ["  74 ", "                printf(\"Nothing came for %u seconds; stopped.\\n\", WAIT_SECS);"], ["  75 ", "                result = 1;"], ["  76 ", "                break;"], ["  77 ", "            }"], ["  78 ", "            continue;"], ["  79 ", "        }"], ["  80 ", "        len = avail > BUFSZ ? BUFSZ : avail;        /* never more than waits */"], ["  81 ", "        len = network_read(spec, buf, len);"], ["  82 ", "        if (fwrite(buf, 1, len, f) != len) {"], ["  83 ", "            printf(\"Cannot write the file (disk full?).\\n\");"], ["  84 ", "            result = 1;"], ["  85 ", "            break;"], ["  86 ", "        }"], ["  87 ", "        total += len;"], ["  88 ", "        last = TICKS;"], ["  89 ", "    }"], ["  90 ", ""], ["  91 ", "    network_close(spec);"], ["  92 ", "    fclose(f);"], ["  93 ", "    if (!result)"], ["  94 ", "        printf(\"%lu bytes copied.\\n\", total);"], ["  95 ", "out:"], ["  96 ", "    con_exit();"], ["  97 ", "    return result;"], ["  98 ", "}"]]}], "total_lines": 98, "printed_lines": 98, "wrap": 95}