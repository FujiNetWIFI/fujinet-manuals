{"name": "nget-asm", "files": [{"path": "src/asm/nget/nget.asm", "lines": 208, "sha256": "ed0695e3487787df04f9bb01a8e45e3e7c1b35fef101332125f97b30b1de6e47", "printed": [["   1 ", ";-----------------------------------------------------------------------------"], ["   2 ", "; NGET -- copy a file from the network to a disk. Opens the devicespec on"], ["   3 ", "; network unit 1 for reading, and writes whatever comes to the file, until"], ["   4 ", "; the FujiNet says the end has been reached."], ["   5 ", ";"], ["   6 ", ";   NGET N:HTTP://192.168.1.10/hello.txt SY1:HELLO.TXT      (HDOS)"], ["   7 ", ";   NGET N:TNFS://tnfs.fujinet.online/README.TXT B:README.TXT  (CP/M)"], ["   8 ", ";"], ["   9 ", "; Any scheme a channel can read will do (Chapter 11). HDOS and CP/M keep"], ["  10 ", "; files in whole sectors (256 bytes) and records (128), so the copy ends"], ["  11 ", "; with up to a sector of zeros, or a record of CTRL-Z, after the data."], ["  12 ", ";"], ["  13 ", "; One source, two systems:"], ["  14 ", ";   z88dk-z80asm -b -DHDOS -Isrc/asm/inc nget.asm   ->  NGET.ABS (HDOS)"], ["  15 ", ";   z88dk-z80asm -b -DCPM  -Isrc/asm/inc nget.asm   ->  NGET.COM (CP/M)"], ["  16 ", ";"], ["  17 ", "; Copyright (C) 2026 Thomas Cherryhomes"], ["  18 ", "; SPDX-License-Identifier: GPL-3.0-or-later"], ["  19 ", ";-----------------------------------------------------------------------------"], ["  20 ", "INCLUDE \"os.inc\""], ["  21 ", "INCLUDE \"fujinet.inc\""], ["  22 ", ""], ["  23 ", "BUFSZ           equ     512             ; bytes taken from the FujiNet at once"], ["  24 ", "EOF_ERR         equ     136             ; STATUS error: the end of the data"], ["  25 ", "WAIT_SECS       equ     30              ; give up after this long with nothing"], ["  26 ", ""], ["  27 ", "main:"], ["  28 ", "        ld      hl,t_banner"], ["  29 ", "        call    print"], ["  30 ", "        call    card_on"], ["  31 ", "        call    card_present"], ["  32 ", "        jp      nz,no_card"], ["  33 ", ""], ["  34 ", "        call    args                    ; NGET devicespec file"], ["  35 ", "        ld      de,spec"], ["  36 ", "        call    word"], ["  37 ", "        jr      nz,two_words"], ["  38 ", "        ld      hl,t_from               ; none: ask, since CP/M turns a"], ["  39 ", "        call    print                   ;   command line into capitals"], ["  40 ", "        ld      hl,spec"], ["  41 ", "        ld      b,128"], ["  42 ", "        call    getline"], ["  43 ", "        ld      hl,t_to"], ["  44 ", "        call    print"], ["  45 ", "        ld      hl,fname"], ["  46 ", "        ld      b,30"], ["  47 ", "        call    getline"], ["  48 ", "        jr      got_words"], ["  49 ", "two_words:"], ["  50 ", "        ld      de,fname"], ["  51 ", "        call    word"], ["  52 ", "        jp      z,usage"], ["  53 ", "got_words:"], ["  54 ", "        ld      de,spec                 ; N: in front if it is missing"], ["  55 ", "        call    netspec"], ["  56 ", ""], ["  57 ", "        ld      hl,spec                 ; open it for reading (mode 4),"], ["  58 ", "        call    strlen                  ;   no translation"], ["  59 ", "        ld      (rq_open+RQ_PLEN),bc"], ["  60 ", "        ld      hl,rq_open"], ["  61 ", "        call    fn_call"], ["  62 ", "        jp      nz,no_open"], ["  63 ", "        ld      hl,fname                ; and the file to write"], ["  64 ", "        call    f_create"], ["  65 ", "        jp      c,no_file"], ["  66 ", ""], ["  67 ", "        ld      hl,(TICKS)              ; when data last came"], ["  68 ", "        ld      (t_last),hl"], ["  69 ", "copy:"], ["  70 ", "        ld      hl,rq_status            ; how much is waiting?"], ["  71 ", "        call    fn_call"], ["  72 ", "        jp      nz,net_error"], ["  73 ", "        ld      hl,(nstat+NS_AVAIL)"], ["  74 ", "        ld      a,h"], ["  75 ", "        or      l"], ["  76 ", "        jr      nz,fetch"], ["  77 ", "        ld      a,(nstat+NS_ERR)        ; nothing: the end?"], ["  78 ", "        cp      EOF_ERR"], ["  79 ", "        jr      z,done"], ["  80 ", "        cp      2                       ; an error (1 is all well)"], ["  81 ", "        jp      nc,net_error"], ["  82 ", "        ld      a,(nstat+NS_CONN)       ; the far end gone, nothing left"], ["  83 ", "        or      a"], ["  84 ", "        jr      z,done"], ["  85 ", "        ld      hl,(TICKS)              ; still waiting: for too long?"], ["  86 ", "        ld      de,(t_last)"], ["  87 ", "        or      a"], ["  88 ", "        sbc     hl,de"], ["  89 ", "        ld      de,WAIT_SECS*500"], ["  90 ", "        or      a"], ["  91 ", "        sbc     hl,de"], ["  92 ", "        jr      c,copy"], ["  93 ", "        jp      timed_out"], ["  94 ", "fetch:"], ["  95 ", "        ld      de,BUFSZ                ; never ask for more than waits"], ["  96 ", "        or      a"], ["  97 ", "        sbc     hl,de"], ["  98 ", "        add     hl,de"], ["  99 ", "        jr      c,fetch1"], [" 100 ", "        ex      de,hl"], [" 101 ", "fetch1:"], [" 102 ", "        ld      (rq_read+RQ_AUX1),hl"], [" 103 ", "        ld      hl,rq_read"], [" 104 ", "        call    fn_call"], [" 105 ", "        jp      nz,net_error"], [" 106 ", "        push    bc                      ; BC bytes came: to the file"], [" 107 ", "        ld      de,rxbuf"], [" 108 ", "        call    f_write"], [" 109 ", "        pop     bc"], [" 110 ", "        jp      c,write_error"], [" 111 ", "        ld      hl,(total)              ; count them"], [" 112 ", "        add     hl,bc"], [" 113 ", "        ld      (total),hl"], [" 114 ", "        ld      hl,(TICKS)"], [" 115 ", "        ld      (t_last),hl"], [" 116 ", "        jr      copy"], [" 117 ", ""], [" 118 ", "done:"], [" 119 ", "        call    finish"], [" 120 ", "        ld      hl,(total)"], [" 121 ", "        call    pdec16"], [" 122 ", "        ld      hl,t_done"], [" 123 ", "        jp      print"], [" 124 ", ""], [" 125 ", "; close the channel and the file, whatever happened"], [" 126 ", "finish:"], [" 127 ", "        ld      hl,rq_close"], [" 128 ", "        call    fn_call"], [" 129 ", "        jp      f_close"], [" 130 ", ""], [" 131 ", "usage:"], [" 132 ", "        ld      hl,t_usage"], [" 133 ", "        jp      print"], [" 134 ", "no_card:"], [" 135 ", "        ld      hl,t_nocard"], [" 136 ", "        jp      print"], [" 137 ", "no_open:"], [" 138 ", "        ld      hl,t_noopen"], [" 139 ", "        jp      print"], [" 140 ", "no_file:"], [" 141 ", "        ld      hl,rq_close"], [" 142 ", "        call    fn_call"], [" 143 ", "        ld      hl,t_nofile"], [" 144 ", "        jp      print"], [" 145 ", "net_error:"], [" 146 ", "        call    finish"], [" 147 ", "        ld      hl,t_neterr"], [" 148 ", "        call    print"], [" 149 ", "        ld      a,(nstat+NS_ERR)"], [" 150 ", "        call    pdec8"], [" 151 ", "        jp      crlf"], [" 152 ", "write_error:"], [" 153 ", "        call    finish"], [" 154 ", "        ld      hl,t_wrerr"], [" 155 ", "        jp      print"], [" 156 ", "timed_out:"], [" 157 ", "        call    finish"], [" 158 ", "        ld      hl,t_tmo"], [" 159 ", "        jp      print"], [" 160 ", ""], [" 161 ", "rq_open:"], [" 162 ", "        FNREQ   DEV_NETWORK, NET_OPEN, F_A1_A2, 4,0,0,0"], [" 163 ", "        FNBUF   spec, 0, 0, 0"], [" 164 ", "rq_status:"], [" 165 ", "        FNREQ   DEV_NETWORK, NET_STATUS, F_NONE, 0,0,0,0"], [" 166 ", "        FNBUF   0, 0, nstat, 4"], [" 167 ", "rq_read:"], [" 168 ", "        FNREQ   DEV_NETWORK, NET_READ, F_B12, 0,0,0,0"], [" 169 ", "        FNBUF   0, 0, rxbuf, BUFSZ"], [" 170 ", "rq_close:"], [" 171 ", "        FNREQ   DEV_NETWORK, NET_CLOSE, F_NONE, 0,0,0,0"], [" 172 ", "        FNBUF   0, 0, 0, 0"], [" 173 ", ""], [" 174 ", "t_banner:       defm    \"NGET - copy a file from the network\""], [" 175 ", "                defb    13, 10, 0"], [" 176 ", "t_from:         defm    \"From (devicespec): \""], [" 177 ", "                defb    0"], [" 178 ", "t_to:           defm    \"To (file): \""], [" 179 ", "                defb    0"], [" 180 ", "t_usage:        defm    \"Usage: NGET devicespec file\""], [" 181 ", "                defb    13, 10, 0"], [" 182 ", "t_nocard:       defm    \"No FujiNet card at 0D0H.\""], [" 183 ", "                defb    13, 10, 0"], [" 184 ", "t_noopen:       defm    \"The FujiNet could not open that.\""], [" 185 ", "                defb    13, 10, 0"], [" 186 ", "t_nofile:       defm    \"Cannot create the file.\""], [" 187 ", "                defb    13, 10, 0"], [" 188 ", "t_neterr:       defm    \"Network error \""], [" 189 ", "                defb    0"], [" 190 ", "t_wrerr:        defm    \"Cannot write the file (disk full?).\""], [" 191 ", "                defb    13, 10, 0"], [" 192 ", "t_tmo:          defm    \"Nothing came for 30 seconds; stopped.\""], [" 193 ", "                defb    13, 10, 0"], [" 194 ", "t_done:         defm    \" bytes copied.\""], [" 195 ", "                defb    13, 10, 0"], [" 196 ", ""], [" 197 ", "total:          defw    0"], [" 198 ", "t_last:         defw    0"], [" 199 ", "nstat:          defs    4               ; STATUS: waiting (2), connected, error"], [" 200 ", "spec:           defs    132             ; the devicespec, room for N:"], [" 201 ", "fname:          defs    32              ; the file"], [" 202 ", "rxbuf:          defs    BUFSZ"], [" 203 ", ""], [" 204 ", "INCLUDE \"words.inc\""], [" 205 ", "INCLUDE \"card.inc\""], [" 206 ", "INCLUDE \"fujibus.inc\""], [" 207 ", "INCLUDE \"con.inc\""], [" 208 ", "INCLUDE \"tail.inc\""]]}], "total_lines": 208, "printed_lines": 208, "wrap": 95}