{"name": "netcat-c", "files": [{"path": "src/c/netcat/netcat.c", "lines": 120, "sha256": "de61db593fc495f9e5f5073ef4fc759b5668a29750af350af7e24b19317a25bb", "printed": [["   1 ", "/*"], ["   2 ", " * NETCAT -- the H89 as a terminal on the network, in C. Opens a connection"], ["   3 ", " * (a TELNET or TCP devicespec, from the command line or asked for), then"], ["   4 ", " * passes keys out and bytes in until the far end hangs up or CTRL-] is"], ["   5 ", " * struck. The H19 is put in ANSI mode for the session, since that is what"], ["   6 ", " * bulletin boards speak, and back in Heath mode after. NETCAT.ASM's twin."], ["   7 ", " *"], ["   8 ", " *   NETCAT N:TELNET://BBS.FOZZTEXX.COM/      or just NETCAT, and answer"], ["   9 ", " *"], ["  10 ", " *   tools/cc.sh hdos NETCAT src/c/netcat/netcat.c src/c/common/h89con.c \\"], ["  11 ", " *       src/c/common/hdosargs.c                       ->  NETCAT.ABS"], ["  12 ", " *   tools/cc.sh cpm NETCAT ...the same...             ->  NETCAT.COM"], ["  13 ", " *"], ["  14 ", " * Copyright (C) 2026 Thomas Cherryhomes"], ["  15 ", " * SPDX-License-Identifier: GPL-3.0-or-later"], ["  16 ", " */"], ["  17 ", "#include <stdio.h>"], ["  18 ", "#include <string.h>"], ["  19 ", "#include <ctype.h>"], ["  20 ", "#include <fujinet-network.h>"], ["  21 ", "#include \"h89con.h\""], ["  22 ", "#include \"hdosargs.h\""], ["  23 ", ""], ["  24 ", "#define QUIT_KEY 0x1D           /* CTRL-] ends the session */"], ["  25 ", "#define BUFSZ    512            /* bytes taken from the FujiNet at once */"], ["  26 ", "#define DEFAULT  \"N:TELNET://BBS.FOZZTEXX.COM/\""], ["  27 ", ""], ["  28 ", "static char spec[124];"], ["  29 ", "static char line[120];"], ["  30 ", "static uint8_t rxbuf[BUFSZ];"], ["  31 ", ""], ["  32 ", "/* a line typed at the keyboard, shown as it is typed */"], ["  33 ", "static void getline(char *buf, uint8_t size)"], ["  34 ", "{"], ["  35 ", "    uint8_t n = 0;"], ["  36 ", "    int c;"], ["  37 ", ""], ["  38 ", "    for (;;) {"], ["  39 ", "        while ((c = con_getc()) < 0)"], ["  40 ", "            ;"], ["  41 ", "        if (c == '\\r')"], ["  42 ", "            break;"], ["  43 ", "        if ((c == 8 || c == 0x7F) && n) {"], ["  44 ", "            n--;"], ["  45 ", "            con_puts(\"\\b \\b\");"], ["  46 ", "        } else if (c >= ' ' && n < size - 1) {"], ["  47 ", "            buf[n++] = c;"], ["  48 ", "            con_putc(c);"], ["  49 ", "        }"], ["  50 ", "    }"], ["  51 ", "    buf[n] = 0;"], ["  52 ", "    con_puts(\"\\r\\n\");"], ["  53 ", "}"], ["  54 ", ""], ["  55 ", "/* what was typed, with N: in front unless it has N: or Nn: already */"], ["  56 ", "static void set_spec(const char *s)"], ["  57 ", "{"], ["  58 ", "    if (toupper(s[0]) == 'N' && (s[1] == ':' || s[2] == ':'))"], ["  59 ", "        strcpy(spec, s);"], ["  60 ", "    else {"], ["  61 ", "        strcpy(spec, \"N:\");"], ["  62 ", "        strcat(spec, s);"], ["  63 ", "    }"], ["  64 ", "}"], ["  65 ", ""], ["  66 ", "int main(int argc, char *argv[])"], ["  67 ", "{"], ["  68 ", "    uint16_t avail, len, i;"], ["  69 ", "    uint8_t connected, err;"], ["  70 ", "    int c;"], ["  71 ", ""], ["  72 ", "    ARGS(argc, argv);"], ["  73 ", "    con_init(1);"], ["  74 ", "    con_puts(\"NETCAT - the H89 on the network.  CTRL-] hangs up.\\r\\n\");"], ["  75 ", ""], ["  76 ", "    if (argc > 1)"], ["  77 ", "        set_spec(argv[1]);"], ["  78 ", "    else {"], ["  79 ", "        con_puts(\"Connect to (RETURN for BBS.FOZZTEXX.COM): \");"], ["  80 ", "        getline(line, sizeof line);"], ["  81 ", "        set_spec(line[0] ? line : DEFAULT);"], ["  82 ", "    }"], ["  83 ", "    con_puts(\"Connecting to \");"], ["  84 ", "    con_puts(spec);"], ["  85 ", "    con_puts(\"\\r\\n\");"], ["  86 ", ""], ["  87 ", "    if (network_open(spec, 12, 0) != FN_ERR_OK) {   /* read and write */"], ["  88 ", "        con_puts(\"The FujiNet could not open that.\\r\\n\");"], ["  89 ", "        con_exit();"], ["  90 ", "        return 1;"], ["  91 ", "    }"], ["  92 ", "    con_puts(\"\\x1B<\");                              /* the H19 in ANSI mode */"], ["  93 ", ""], ["  94 ", "    for (;;) {"], ["  95 ", "        c = con_getc();                             /* a key struck? */"], ["  96 ", "        if (c == QUIT_KEY)"], ["  97 ", "            break;"], ["  98 ", "        if (c >= 0) {"], ["  99 ", "            rxbuf[0] = c;                           /* send it */"], [" 100 ", "            network_write(spec, rxbuf, 1);"], [" 101 ", "        }"], [" 102 ", "        if (network_status(spec, &avail, &connected, &err) != FN_ERR_OK)"], [" 103 ", "            continue;"], [" 104 ", "        if (!avail) {"], [" 105 ", "            if (!connected)                         /* the far end has gone */"], [" 106 ", "                break;"], [" 107 ", "            continue;"], [" 108 ", "        }"], [" 109 ", "        len = avail > BUFSZ ? BUFSZ : avail;        /* take what waits */"], [" 110 ", "        len = network_read(spec, rxbuf, len);"], [" 111 ", "        for (i = 0; i < len; i++)                   /* and type it */"], [" 112 ", "            con_putc(rxbuf[i]);"], [" 113 ", "    }"], [" 114 ", ""], [" 115 ", "    con_puts(\"\\x1B[?2h\");                           /* back to Heath mode */"], [" 116 ", "    network_close(spec);"], [" 117 ", "    con_puts(\"\\r\\nDisconnected.\\r\\n\");"], [" 118 ", "    con_exit();"], [" 119 ", "    return 0;"], [" 120 ", "}"]]}], "total_lines": 120, "printed_lines": 120, "wrap": 95}