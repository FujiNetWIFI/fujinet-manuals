{"name": "nput-asm", "files": [{"path": "src/asm/nput/nput.asm", "lines": 154, "sha256": "591f24b4ef670106e282bf8be5b129704c6f2693cd01ced31e93351ca6b07220", "printed": [["   1 ", ";-----------------------------------------------------------------------------"], ["   2 ", "; NPUT -- copy a file from a disk to the network. Opens the devicespec on"], ["   3 ", "; network unit 1 for writing, sends the file in pieces, and closes the"], ["   4 ", "; channel, which is when an HTTP PUT is really sent."], ["   5 ", ";"], ["   6 ", ";   NPUT SY1:HELLO.TXT N:HTTP://192.168.1.10/hello.txt      (HDOS)"], ["   7 ", ";   NPUT B:NOTES.TXT N:TNFS://myserver/notes.txt            (CP/M)"], ["   8 ", ";"], ["   9 ", "; HDOS and CP/M know a file's length only in whole sectors (256 bytes) and"], ["  10 ", "; records (128), so the copy is that long: a text file arrives with the"], ["  11 ", "; zeros or CTRL-Zs that fill its last sector or record."], ["  12 ", ";"], ["  13 ", "; One source, two systems:"], ["  14 ", ";   z88dk-z80asm -b -DHDOS -Isrc/asm/inc nput.asm   ->  NPUT.ABS (HDOS)"], ["  15 ", ";   z88dk-z80asm -b -DCPM  -Isrc/asm/inc nput.asm   ->  NPUT.COM (CP/M)"], ["  16 ", ";"], ["  17 ", "; Copyright (C) 2026 Thomas Cherryhomes"], ["  18 ", "; SPDX-License-Identifier: GPL-3.0-or-later"], ["  19 ", ";-----------------------------------------------------------------------------"], ["  20 ", "INCLUDE \"os.inc\""], ["  21 ", "INCLUDE \"fujinet.inc\""], ["  22 ", ""], ["  23 ", "BUFSZ           equ     512             ; bytes sent to the FujiNet at once"], ["  24 ", ""], ["  25 ", "main:"], ["  26 ", "        ld      hl,t_banner"], ["  27 ", "        call    print"], ["  28 ", "        call    card_on"], ["  29 ", "        call    card_present"], ["  30 ", "        jp      nz,no_card"], ["  31 ", ""], ["  32 ", "        call    args                    ; NPUT file devicespec"], ["  33 ", "        ld      de,fname"], ["  34 ", "        call    word"], ["  35 ", "        jr      nz,two_words"], ["  36 ", "        ld      hl,t_from               ; none: ask, since CP/M turns a"], ["  37 ", "        call    print                   ;   command line into capitals"], ["  38 ", "        ld      hl,fname"], ["  39 ", "        ld      b,30"], ["  40 ", "        call    getline"], ["  41 ", "        ld      hl,t_to"], ["  42 ", "        call    print"], ["  43 ", "        ld      hl,spec"], ["  44 ", "        ld      b,128"], ["  45 ", "        call    getline"], ["  46 ", "        jr      got_words"], ["  47 ", "two_words:"], ["  48 ", "        ld      de,spec"], ["  49 ", "        call    word"], ["  50 ", "        jp      z,usage"], ["  51 ", "got_words:"], ["  52 ", "        ld      de,spec                 ; N: in front if it is missing"], ["  53 ", "        call    netspec"], ["  54 ", "        ld      hl,fname                ; the file to send"], ["  55 ", "        call    f_open"], ["  56 ", "        jp      c,no_file"], ["  57 ", ""], ["  58 ", "        ld      hl,spec                 ; open it for writing (mode 8),"], ["  59 ", "        call    strlen                  ;   no translation"], ["  60 ", "        ld      (rq_open+RQ_PLEN),bc"], ["  61 ", "        ld      hl,rq_open"], ["  62 ", "        call    fn_call"], ["  63 ", "        jp      nz,no_open"], ["  64 ", ""], ["  65 ", "copy:"], ["  66 ", "        ld      de,txbuf                ; a piece of the file"], ["  67 ", "        ld      bc,BUFSZ"], ["  68 ", "        call    f_read"], ["  69 ", "        ld      a,b"], ["  70 ", "        or      c"], ["  71 ", "        jr      z,done                  ; the end of the file"], ["  72 ", "        ld      (rq_write+RQ_AUX1),bc   ; the length, as a field"], ["  73 ", "        ld      (rq_write+RQ_PLEN),bc   ;   and of the payload"], ["  74 ", "        push    bc"], ["  75 ", "        ld      hl,rq_write"], ["  76 ", "        call    fn_call"], ["  77 ", "        pop     bc"], ["  78 ", "        jr      nz,net_error"], ["  79 ", "        ld      hl,(total)"], ["  80 ", "        add     hl,bc"], ["  81 ", "        ld      (total),hl"], ["  82 ", "        jr      copy"], ["  83 ", ""], ["  84 ", "done:"], ["  85 ", "        ld      hl,rq_close             ; CLOSE: an HTTP PUT goes now"], ["  86 ", "        call    fn_call"], ["  87 ", "        push    af"], ["  88 ", "        call    f_close"], ["  89 ", "        pop     af"], ["  90 ", "        jr      nz,net_error"], ["  91 ", "        ld      hl,(total)"], ["  92 ", "        call    pdec16"], ["  93 ", "        ld      hl,t_done"], ["  94 ", "        jp      print"], ["  95 ", ""], ["  96 ", "usage:"], ["  97 ", "        ld      hl,t_usage"], ["  98 ", "        jp      print"], ["  99 ", "no_card:"], [" 100 ", "        ld      hl,t_nocard"], [" 101 ", "        jp      print"], [" 102 ", "no_file:"], [" 103 ", "        ld      hl,t_nofile"], [" 104 ", "        jp      print"], [" 105 ", "no_open:"], [" 106 ", "        call    f_close"], [" 107 ", "        ld      hl,t_noopen"], [" 108 ", "        jp      print"], [" 109 ", "net_error:"], [" 110 ", "        ld      hl,rq_close"], [" 111 ", "        call    fn_call"], [" 112 ", "        call    f_close"], [" 113 ", "        ld      hl,t_neterr"], [" 114 ", "        jp      print"], [" 115 ", ""], [" 116 ", "rq_open:"], [" 117 ", "        FNREQ   DEV_NETWORK, NET_OPEN, F_A1_A2, 8,0,0,0"], [" 118 ", "        FNBUF   spec, 0, 0, 0"], [" 119 ", "rq_write:                               ; length set before each write"], [" 120 ", "        FNREQ   DEV_NETWORK, NET_WRITE, F_B12, 0,0,0,0"], [" 121 ", "        FNBUF   txbuf, 0, 0, 0"], [" 122 ", "rq_close:"], [" 123 ", "        FNREQ   DEV_NETWORK, NET_CLOSE, F_NONE, 0,0,0,0"], [" 124 ", "        FNBUF   0, 0, 0, 0"], [" 125 ", ""], [" 126 ", "t_banner:       defm    \"NPUT - copy a file to the network\""], [" 127 ", "                defb    13, 10, 0"], [" 128 ", "t_from:         defm    \"From (file): \""], [" 129 ", "                defb    0"], [" 130 ", "t_to:    