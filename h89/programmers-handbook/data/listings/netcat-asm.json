{"name": "netcat-asm", "files": [{"path": "src/asm/netcat/netcat.asm", "lines": 199, "sha256": "bca29678ed0157da182f2a119fe4f9ff440364dbcf3de6b080b5919aac3c5412", "printed": [["   1 ", ";-----------------------------------------------------------------------------"], ["   2 ", "; NETCAT -- the H89 as a terminal on the network. Opens a connection on"], ["   3 ", "; network unit 1 (a TELNET or TCP devicespec, typed on the command line or"], ["   4 ", "; asked for), then passes keys out and bytes in until the far end hangs up"], ["   5 ", "; or CTRL-] is struck. The H19 is put in ANSI mode for the session, since"], ["   6 ", "; that is what bulletin boards speak, and back in Heath mode after."], ["   7 ", ";"], ["   8 ", ";   NETCAT N:TELNET://BBS.FOZZTEXX.COM/      or just NETCAT, and answer"], ["   9 ", ";"], ["  10 ", "; One source, two systems:"], ["  11 ", ";   z88dk-z80asm -b -DHDOS -Isrc/asm/inc netcat.asm  ->  NETCAT.ABS (HDOS)"], ["  12 ", ";   z88dk-z80asm -b -DCPM  -Isrc/asm/inc netcat.asm  ->  NETCAT.COM (CP/M)"], ["  13 ", ";"], ["  14 ", "; Copyright (C) 2026 Thomas Cherryhomes"], ["  15 ", "; SPDX-License-Identifier: GPL-3.0-or-later"], ["  16 ", ";-----------------------------------------------------------------------------"], ["  17 ", "INCLUDE \"os.inc\""], ["  18 ", "INCLUDE \"fujinet.inc\""], ["  19 ", ""], ["  20 ", "QUIT_KEY        equ     0x1D            ; CTRL-] ends the session"], ["  21 ", "BUFSZ           equ     512             ; bytes taken from the FujiNet at once"], ["  22 ", "ESC             equ     0x1B"], ["  23 ", ""], ["  24 ", "main:"], ["  25 ", "        ld      hl,t_banner"], ["  26 ", "        call    print"], ["  27 ", "        call    card_on                 ; set the card up"], ["  28 ", "        call    card_present"], ["  29 ", "        jp      nz,no_card"], ["  30 ", ""], ["  31 ", "        call    args                    ; a devicespec on the command line?"], ["  32 ", "        ld      a,(hl)"], ["  33 ", "        or      a"], ["  34 ", "        jr      nz,have_spec"], ["  35 ", "        ld      hl,t_ask                ; no: ask for one"], ["  36 ", "        call    print"], ["  37 ", "        ld      hl,line"], ["  38 ", "        ld      b,120"], ["  39 ", "        call    getline"], ["  40 ", "        ld      a,(hl)"], ["  41 ", "        or      a"], ["  42 ", "        jr      nz,have_spec"], ["  43 ", "        ld      hl,t_default            ; just RETURN: the default"], ["  44 ", "have_spec:"], ["  45 ", "        call    set_spec                ; to spec, with N: in front"], ["  46 ", "        ld      hl,t_conn"], ["  47 ", "        call    print"], ["  48 ", "        ld      hl,spec"], ["  49 ", "        call    print"], ["  50 ", "        call    crlf"], ["  51 ", ""], ["  52 ", "        ld      hl,spec                 ; open the connection: the payload"], ["  53 ", "        call    strlen                  ;   is the devicespec"], ["  54 ", "        ld      (rq_open+RQ_PLEN),bc"], ["  55 ", "        ld      hl,rq_open"], ["  56 ", "        call    fn_call"], ["  57 ", "        jp      nz,open_failed"], ["  58 ", "        ld      hl,t_ansi               ; the H19 in ANSI mode"], ["  59 ", "        call    print"], ["  60 ", ""], ["  61 ", "loop:"], ["  62 ", "        call    conin                   ; a key struck?"], ["  63 ", "        jr      c,poll"], ["  64 ", "        cp      QUIT_KEY"], ["  65 ", "        jr      z,hangup"], ["  66 ", "        ld      (outch),a               ; send it: one byte"], ["  67 ", "        ld      hl,rq_write"], ["  68 ", "        call    fn_call"], ["  69 ", "poll:"], ["  70 ", "        ld      hl,rq_status            ; anything come in?"], ["  71 ", "        call    fn_call"], ["  72 ", "        jr      nz,loop"], ["  73 ", "        ld      hl,(nstat+NS_AVAIL)"], ["  74 ", "        ld      a,h"], ["  75 ", "        or      l"], ["  76 ", "        jr      nz,fetch"], ["  77 ", "        ld      a,(nstat+NS_CONN)       ; nothing: still connected?"], ["  78 ", "        or      a"], ["  79 ", "        jr      nz,loop"], ["  80 ", "        jr      hungup                  ; the far end has gone"], ["  81 ", "fetch:"], ["  82 ", "        ld      de,BUFSZ                ; take what waits, a buffer at most"], ["  83 ", "        or      a"], ["  84 ", "        sbc     hl,de"], ["  85 ", "        add     hl,de"], ["  86 ", "        jr      c,fetch1"], ["  87 ", "        ex      de,hl"], ["  88 ", "fetch1:"], ["  89 ", "        ld      (rq_read+RQ_AUX1),hl    ; the read's length field"], ["  90 ", "        ld      hl,rq_read"], ["  91 ", "        call    fn_call"], ["  92 ", "        jr      nz,loop"], ["  93 ", "        ld      hl,rxbuf                ; BC bytes came: type them"], ["  94 ", "show:"], ["  95 ", "        ld      a,b"], ["  96 ", "        or      c"], ["  97 ", "        jr      z,loop"], ["  98 ", "        ld      a,(hl)"], ["  99 ", "        call    conout"], [" 100 ", "        inc     hl"], [" 101 ", "        dec     bc"], [" 102 ", "        jr      show"], [" 103 ", ""], [" 104 ", "hangup:"], [" 105 ", "hungup:"], [" 106 ", "        ld      hl,t_heath              ; the H19 back in Heath mode"], [" 107 ", "        call    print"], [" 108 ", "        ld      hl,rq_close             ; and the connection closed"], [" 109 ", "        call    fn_call"], [" 110 ", "        ld      hl,t_bye"], [" 111 ", "        jp      print"], [" 112 ", ""], [" 113 ", "no_card:"], [" 114 ", "        ld      hl,t_nocard"], [" 115 ", "        jp      print"], [" 116 ", "open_failed:"], [" 117 ", "        ld      hl,t_nopen"], [" 118 ", "        jp      print"], [" 119 ", ""], [" 120 ", "; HL -> what was typed: copy it to spec, putting \"N:\" in front unless it"], [" 121 ", "; starts with N: or Nn: already"], [" 122 ", "set_spec:"], [" 123 ", "        ld      de,spec"], [" 124 ", "        ld      a,(hl)"], [" 125 ", "        and     0xDF                    ; upper case"], [" 126 ", "        cp      'N'"], [" 127 ", "        jr      nz,set_n"], [" 128 ", "        inc     hl"], [" 129 ", "        ld      a,(hl)"], [" 130 ", "        dec     hl"], [" 131 ", "        cp      ':'"], [" 132 ", "        jr      z,set_copy"], [" 133 ", "        inc     hl"], [" 134 ", "        inc     hl"], [" 135 ", "        ld      a,(hl)"], [" 136 ", "        dec     hl"], [" 137 ", "        dec     hl"], [" 138 ", "        cp      ':'"], [" 139 ", "        jr      z,set_copy"], [" 140 ", "set_n:"], [" 141 ", "        ld      a,'N'"], [" 142 ", "        ld      (de),a"], [" 143 ", "        inc     de"], [" 144 ", "        ld      a,':'"], [" 145 ", "        ld      (de),a"], [" 146 ", "        inc     de"], [" 147 ", "set_copy:"], [" 148 ", "        ld      a,(hl)"], [" 149 ", "        ld      (de),a"], [" 150 ", "        inc     hl"], [" 151 ", "        inc     de"], [" 152 ", "        or      a"], [" 153 ", "        jr      nz,set_copy"], [" 154 ", "        ret"], [" 155 ", ""], [" 156 ", "rq_open:                                ; mode 12: read and write; no"], [" 157 ", "        FNREQ   DEV_NETWORK, NET_OPEN, F_A1_A2, 12,0,0,0    ;   translation"], [" 158 ", "        FNBUF   spec, 0, 0, 0"], [" 159 ", "rq_status:"], [" 160 ", "        FNREQ   DEV_NETWORK, NET_STATUS, F_NONE, 0,0,0,0"], [" 161 ", "        FNBUF   0, 0, nstat, 4"], [" 162 ", "rq_read:                                ; length set before each read"], [" 163 ", "        FNREQ   DEV_NETWORK, NET_READ, F_B12, 0,0,0,0"], [" 164 ", "        FNBUF   0, 0, rxbuf, BUFSZ"], [" 165 ", "rq_write:"], [" 166 ", "        FNREQ   DEV_NETWORK, NET_WRITE, F_B12, 1,0,0,0"], [" 167 ", "        FNBUF   outch, 1, 0, 0"], [" 168 ", "rq_close:"], [" 169 ", "        FNREQ   DEV_NETWORK, NET_CLOSE, F_NONE, 0,0,0,0"], [" 170 ", "        FNBUF   0, 0, 0, 0"], [" 171 ", ""], [" 172 ", "t_banner:       defm    \"NETCAT - the H89 on the network.  CTRL-] hangs up.\""], [" 173 ", "                defb    13, 10, 0"], [" 174 ", "t_ask:          defm    \"Connect to (RETURN for BBS.FOZZTEXX.COM): \""], [" 175 ", "                defb    0"], [" 176 ", "t_default:      defm    \"N:TELNET://BBS.FOZZTEXX.COM/\""], [" 177 ", "                defb    0"], [" 178 ", "t_conn:         defm    \"Connecting to \""], [" 179 ", "                defb    0"], [" 180 ", "t_ansi:         defb    ESC, '<', 0                 ; H19: enter ANSI mode"], [" 181 ", "t_heath:        defb    ESC, '[', '?', '2', 'h', 0  ; ANSI: back to Heath mode"], [" 182 ", "t_bye:          defb    13, 10"], [" 183 ", "                defm    \"Disconnected.\""], [" 184 ", "                defb    13, 10, 0"], [" 185 ", "t_nocard:       defm    \"No FujiNet card at 0D0H.\""], [" 186 ", "                defb    13, 10, 0"], [" 187 ", "t_nopen:        defm    \"The FujiNet could not open that.\""], [" 188 ", "                defb    13, 10, 0"], [" 189 ", ""], [" 190 ", "outch:          defb    0               ; the key to send"], [" 191 ", "nstat:          defs    4               ; STATUS: waiting (2), connected, error"], [" 192 ", "line:           defs    120             ; what was typed"], [" 193 ", "spec:           defs    124             ; the devicespec"], [" 194 ", "rxbuf:          defs    BUFSZ"], [" 195 ", ""], [" 196 ", "INCLUDE \"card.inc\""], [" 197 ", "INCLUDE \"fujibus.inc\""], [" 198 ", "INCLUDE \"con.inc\""], [" 199 ", "INCLUDE \"tail.inc\""]]}], "total_lines": 199, "printed_lines": 199, "wrap": 95}