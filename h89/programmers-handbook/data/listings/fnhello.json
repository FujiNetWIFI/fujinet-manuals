{"name": "fnhello", "files": [{"path": "src/asm/hello/fnhello.asm", "lines": 85, "sha256": "3ff654bb4cf93fc558cda115c4b1a8df4f222fdd9ad32654731c09bb56638c25", "printed": [["   1 ", ";-----------------------------------------------------------------------------"], ["   2 ", "; FNHELLO -- first contact. Sets the FujiNet card up, asks it for its adapter"], ["   3 ", "; configuration, and prints the network it has joined, its name, its address"], ["   4 ", "; and its firmware version. One source, two systems:"], ["   5 ", ";   z88dk-z80asm -b -DHDOS -I=../inc fnhello.asm   ->  FNHELLO.ABS (HDOS)"], ["   6 ", ";   z88dk-z80asm -b -DCPM  -I=../inc fnhello.asm   ->  FNHELLO.COM (CP/M)"], ["   7 ", ";"], ["   8 ", "; Copyright (C) 2026 Thomas Cherryhomes"], ["   9 ", "; SPDX-License-Identifier: GPL-3.0-or-later"], ["  10 ", ";-----------------------------------------------------------------------------"], ["  11 ", "INCLUDE \"os.inc\""], ["  12 ", "INCLUDE \"fujinet.inc\""], ["  13 ", ""], ["  14 ", "main:"], ["  15 ", "        ld      hl,t_banner"], ["  16 ", "        call    print"], ["  17 ", "        call    card_on                 ; set the card up"], ["  18 ", "        call    card_present"], ["  19 ", "        jr      nz,no_card"], ["  20 ", "        ld      hl,rq_config            ; ask for the adapter configuration"], ["  21 ", "        call    fn_call"], ["  22 ", "        jr      nz,failed"], ["  23 ", "        ld      hl,t_ssid"], ["  24 ", "        call    print"], ["  25 ", "        ld      hl,cfg_ssid"], ["  26 ", "        call    print"], ["  27 ", "        ld      hl,t_host"], ["  28 ", "        call    print"], ["  29 ", "        ld      hl,cfg_host"], ["  30 ", "        call    print"], ["  31 ", "        ld      hl,t_ip"], ["  32 ", "        call    print"], ["  33 ", "        ld      hl,cfg_ip"], ["  34 ", "        call    pip"], ["  35 ", "        ld      hl,t_ver"], ["  36 ", "        call    print"], ["  37 ", "        ld      hl,cfg_ver"], ["  38 ",