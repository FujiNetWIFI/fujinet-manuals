

                ;	FNON.ASM - enable the FujiNet card in an H89 (82C55 at 0D0H)
                ;
                ;	Sets the 82C55 to Mode 2, boots the ESP32 from flash and turns
                ;	the 74LVC245 toward the H89. Leaves a card that is already on alone:
                ;	whatever sets the card up leaves 0A5H in port B, which a reset or
                ;	another mode word clears. EN alone can't tell, as after a reset the
                ;	82C55's bus hold can pull PC2 high while port A isn't in Mode 2.
                ;
                ;	A>ASM B:FNON
                ;	A>LOAD B:FNON
                ;	A>B:FNON
                ;
                ;	From FujiNet Go H89's CP/M disks: fujinet-go-h89-desktop
                ;	tools/disks/fnon/FNON.ASM (51f411d), code unchanged.
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D1 =         PORTB	EQU	0D1H		;WIRED TO NOTHING: HOLDS MARK ONCE SET UP
 00D2 =         PORTC	EQU	0D2H		;PC0 DIR, PC1 /OE (ESP32 IO0), PC2 ESP32 EN
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 00A5 =         MARK	EQU	0A5H		;AS FUJINET-LIB'S PORT_INIT LEAVES IT
 0005 =         BDOS	EQU	0005H
 0009 =         PRINT	EQU	9		;BDOS PRINT STRING
                ;
 0100           	ORG	0100H
                ;
 0100 DBD1      START:	IN	PORTB
 0102 FEA5      	CPI	MARK		;MARK AND EN HIGH: CARD ALREADY RUNNING
 0104 C20E01    	JNZ	SETUP
 0107 DBD2      	IN	PORTC
 0109 E604      	ANI	04H
 010B C23001    	JNZ	ISON
 010E 3EC0      SETUP:	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS
 0110 D3D3      	OUT	PCTRL		;(CLEARS PORT C, SO EN GOES LOW)
 0112 3E06      	MVI	A,06H		;EN=1, IO0=1 AT ONCE: A RUNNING ESP32
 0114 D3D2      	OUT	PORTC		;STAYS UP, ONE IN RESET BOOTS FROM FLASH
 0116 016842    	LXI	B,17000		;KEEP IO0 HIGH WHILE IT STARTS, ~200 MS
 0119 CD3901    	CALL	WAIT
 011C 3EA5      	MVI	A,MARK		;THE CARD IS SET UP
 011E D3D1      	OUT	PORTB
 0120 DBD0      	IN	PORTA		;DROP ANY BYTE LATCHED DURING RESET
 0122 3E02      	MVI	A,02H		;PC1=0: ENABLE THE 245
 0124 D3D3      	OUT	PCTRL
 0126 3E00      	MVI	A,00H		;PC0=0: 245 DRIVES TOWARD THE H89
 0128 D3D3      	OUT	PCTRL
 012A 114001    	LXI	D,MSGON
 012D C33301    	JMP	DONE
 0130 115201    ISON:	LXI	D,MSGRUN
 0133 0E09      DONE:	MVI	C,PRINT
 0135 CD0500    	CALL	BDOS
 0138 C9        	RET
                ;
 0139 0B        WAIT:	DCX	B		;ABOUT 12 US A PASS AT 2 MHZ
 013A 78        	MOV	A,B
 013B B1        	ORA	C
 013C C23901    	JNZ	WAIT
 013F C9        	RET
                ;
 0140 46756A694EMSGON:	DB	'FujiNet enabled',0DH,0AH,'$'
 0152 46756A694EMSGRUN:	DB	'FujiNet already on',0DH,0AH,'$'
                ;
 0167           	END	START
