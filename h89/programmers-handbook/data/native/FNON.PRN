

                ;	FNON.ASM - enable the FujiNet card in an H89 (82C55 at 0D0H)
                ;
                ;	Sets the 82C55 to Mode 2, boots the ESP32 from flash and turns
                ;	the 74LVC245 toward the H89. Leaves a card that is already on alone.
                ;
                ;	A>ASM B:FNON
                ;	A>LOAD B:FNON
                ;	A>B:FNON
                ;
                ;	From FujiNet Go H89's CP/M disks: fujinet-go-h89-desktop
                ;	tools/disks/fnon/FNON.ASM (8dc059d), code unchanged.
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D2 =         PORTC	EQU	0D2H		;PC0 DIR, PC1 /OE (ESP32 IO0), PC2 ESP32 EN
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 0005 =         BDOS	EQU	0005H
 0009 =         PRINT	EQU	9		;BDOS PRINT STRING
                ;
 0100           	ORG	0100H
                ;
 0100 DBD2      START:	IN	PORTC
 0102 E604      	ANI	04H		;EN HIGH: CARD ALREADY RUNNING
 0104 C23301    	JNZ	ISON
 0107 3EC0      	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS
 0109 D3D3      	OUT	PCTRL		;(CLEARS PORT C, SO EN GOES LOW)
 010B 3E06      	MVI	A,06H		;EN=1, IO0=1
 010D D3D2      	OUT	PORTC
 010F 3E02      	MVI	A,02H		;EN=0 WITH IO0 ALREADY HIGH
 0111 D3D2      	OUT	PORTC
 0113 016400    	LXI	B,100		;HOLD RESET ABOUT 1 MS
 0116 CD3C01    	CALL	WAIT
 0119 3E06      	MVI	A,06H		;EN=1: IO0 HIGH = BOOT FROM FLASH
 011B D3D2      	OUT	PORTC
 011D 016842    	LXI	B,17000		;KEEP IO0 HIGH WHILE IT STARTS, ~200 MS
 0120 CD3C01    	CALL	WAIT
 0123 DBD0      	IN	PORTA		;DROP ANY BYTE LATCHED DURING RESET
 0125 3E02      	MVI	A,02H		;PC1=0: ENABLE THE 245
 0127 D3D3      	OUT	PCTRL
 0129 3E00      	MVI	A,00H		;PC0=0: 245 DRIVES TOWARD THE H89
 012B D3D3      	OUT	PCTRL
 012D 114301    	LXI	D,MSGON
 0130 C33601    	JMP	DONE
 0133 115501    ISON:	LXI	D,MSGRUN
 0136 0E09      DONE:	MVI	C,PRINT
 0138 CD0500    	CALL	BDOS
 013B C9        	RET
                ;
 013C 0B        WAIT:	DCX	B		;ABOUT 12 US A PASS AT 2 MHZ
 013D 78        	MOV	A,B
 013E B1        	ORA	C
 013F C23C01    	JNZ	WAIT
 0142 C9        	RET
                ;
 0143 46756A694EMSGON:	DB	'FujiNet enabled',0DH,0AH,'$'
 0155 46756A694EMSGRUN:	DB	'FujiNet already on',0DH,0AH,'$'
                ;
 016A           	END	START
