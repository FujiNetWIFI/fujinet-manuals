

                ;	FNVER.ASM - ask the H89 FujiNet for its firmware version
                ;
                ;	Sets up the card's 82C55, sends FUJI_GET_ADAPTERCONFIG
                ;	(device 70H, command 0E8H) in a SLIP frame, checks the reply
                ;	and prints the network name and firmware version. Pure 8080.
                ;
                ;	A>ASM B:FNVER
                ;	A>LOAD B:FNVER
                ;	A>B:FNVER
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D2 =         PORTC	EQU	0D2H		;STATUS IN, PC0-PC2 OUT
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 0080 =         OBF	EQU	80H		;PC7 /OBF: 1 = OUR LAST BYTE WAS TAKEN
 0020 =         IBF	EQU	20H		;PC5 IBF: 1 = A BYTE WAITS FOR US
 000B =         TICKS	EQU	000BH		;HEATH BIOS 2 MS CLOCK
 1D4C =         TMAX	EQU	7500		;GIVE UP AFTER 15 S (7500 TICKS)
 0005 =         BDOS	EQU	0005H
 00C0 =         SLEND	EQU	0C0H		;SLIP END: FRAMES A PACKET
 00DB =         SLESC	EQU	0DBH		;SLIP ESC
 00DC =         ESCEND	EQU	0DCH		;DB DC STANDS FOR A C0H
 00DD =         ESCESC	EQU	0DDH		;DB DD STANDS FOR A DBH
 00C8 =         RMAX	EQU	200		;REPLY BUFFER SIZE
                ;
 0100           	ORG	0100H
                ;
 0100 210000    START:	LXI	H,0		;KEEP THE CCP'S STACK POINTER
 0103 39        	DAD	SP
 0104 22A002    	SHLD	OLDSP
 0107 31AA03    	LXI	SP,STACK	;AND USE OUR OWN
 010A CD4601    	CALL	CARDON		;SET UP THE CARD
 010D CD4D01    	CALL	SENDRQ		;SEND THE REQUEST
 0110 CD8801    	CALL	RECV		;TAKE THE REPLY
 0113 CDC101    	CALL	CHECK		;CARRY: DE -> WHAT WAS WRONG
 0116 DA3801    	JC	EXIT
 0119 115B02    	LXI	D,MNET
 011C CD5002    	CALL	PRMSG
 011F 21A802    	LXI	H,REPLY+6	;SSID: OFFSET 0, 33 BYTES
 0122 0621      	MVI	B,33
 0124 CD3D02    	CALL	PRFLD
 0127 116602    	LXI	D,MVER
 012A CD5002    	CALL	PRMSG
 012D 212503    	LXI	H,REPLY+6+125	;FN_VERSION: OFFSET 125, 15 BYTES
 0130 060F      	MVI	B,15
 0132 CD3D02    	CALL	PRFLD
 0135 117302    	LXI	D,MEND
 0138 CD5002    EXIT:	CALL	PRMSG
 013B 2AA002    	LHLD	OLDSP		;BACK TO THE CCP
 013E F9        	SPHL
 013F C9        	RET
 0140 119502    TMOUT:	LXI	D,MTIME
 0143 C33801    	JMP	EXIT		;(EXIT RESETS SP)
                ;
 0146 3EC0      CARDON:	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS:
 0148 D3D3      	OUT	PCTRL		;PORT A GOES STRAIGHT TO THE ESP32
 014A DBD0      	IN	PORTA		;DROP ANY BYTE LATCHED BEFORE
 014C C9        	RET
                ;
 014D 215502    SENDRQ:	LXI	H,PKT		;CHECKSUM THE PACKET, BYTE 4 AS 0
 0150 0606      	MVI	B,6
 0152 CDFD01    	CALL	CKSUM
 0155 325902    	STA	PKT+4
 0158 3EC0      	MVI	A,SLEND		;ONE END BEFORE THE PACKET
 015A CD0702    	CALL	PUTC
 015D 215502    	LXI	H,PKT
 0160 0606      	MVI	B,6
 0162 7E        SEND1:	MOV	A,M
 0163 FEC0      	CPI	SLEND		;C0H GOES AS DB DC,
 0165 0EDC      	MVI	C,ESCEND	;(MVI LEAVES THE FLAGS ALONE)
 0167 CA7101    	JZ	SEND2
 016A FEDB      	CPI	SLESC		;DBH AS DB DD
 016C 0EDD      	MVI	C,ESCESC
 016E C27701    	JNZ	SEND3
 0171 3EDB      SEND2:	MVI	A,SLESC
 0173 CD0702    	CALL	PUTC
 0176 79        	MOV	A,C
 0177 CD0702    SEND3:	CALL	PUTC
 017A 23        	INX	H
 017B 05        	DCR	B
 017C C26201    	JNZ	SEND1
 017F 3EC0      	MVI	A,SLEND		;ONE END AFTER IT
 0181 CD0702    	CALL	PUTC
 0184 CD0F02    	CALL	TXWAIT		;UNTIL THE ESP32 HAS IT ALL
 0187 C9        	RET
                ;
 0188 CD1402    RECV:	CALL	GETC		;WAIT FOR AN END,
 018B FEC0      	CPI	SLEND
 018D C28801    	JNZ	RECV
 0190 CD1402    RECV1:	CALL	GETC		;SKIP ANY MORE
 0193 FEC0      	CPI	SLEND
 0195 CA9001    	JZ	RECV1
 0198 21A202    	LXI	H,REPLY		;HL -> BUFFER, C = BYTES KEPT
 019B 0E00      	MVI	C,0
 019D FEC0      RECV2:	CPI	SLEND		;THE CLOSING END: DONE
 019F C8        	RZ
 01A0 FEDB      	CPI	SLESC		;ESC: THE NEXT BYTE SAYS WHICH
 01A2 C2B101    	JNZ	RECV3
 01A5 CD1402    	CALL	GETC
 01A8 FEDC      	CPI	ESCEND		;DB DC WAS A C0H,
 01AA 3EC0      	MVI	A,SLEND
 01AC CAB101    	JZ	RECV3
 01AF 3EDB      	MVI	A,SLESC		;DB DD A DBH
 01B1 47        RECV3:	MOV	B,A		;KEEP IT IF THERE IS ROOM
 01B2 79        	MOV	A,C
 01B3 FEC8      	CPI	RMAX
 01B5 D2BB01    	JNC	RECV4
 01B8 70        	MOV	M,B
 01B9 23        	INX	H
 01BA 0C        	INR	C
 01BB CD1402    RECV4:	CALL	GETC
 01BE C39D01    	JMP	RECV2
                ;
 01C1 79        CHECK:	MOV	A,C		;A HEADER AT LEAST
 01C2 FE06      	CPI	6
 01C4 DAF801    	JC	BAD
 01C7 2AA402    	LHLD	REPLY+2		;LENGTH WORD = BYTES RECEIVED
 01CA 7C        	MOV	A,H
 01CB B7        	ORA	A
 01CC C2F801    	JNZ	BAD
 01CF 7D        	MOV	A,L
 01D0 B9        	CMP	C
 01D1 C2F801    	JNZ	BAD
 01D4 21A602    	LXI	H,REPLY+4	;CHECKSUM: ITS OWN BYTE COUNTS AS 0
 01D7 5E        	MOV	E,M
 01D8 3600      	MVI	M,0
 01DA 21A202    	LXI	H,REPLY
 01DD 41        	MOV	B,C
 01DE CDFD01    	CALL	CKSUM
 01E1 BB        	CMP	E
 01E2 C2F801    	JNZ	BAD
 01E5 118202    	LXI	D,MNAK
 01E8 3AA302    	LDA	REPLY+1
 01EB FE15      	CPI	15H		;NAK: THE FUJINET SAID NO
 01ED 37        	STC
 01EE C8        	RZ
 01EF FE06      	CPI	06H		;ACK, WITH ALL 140 BYTES
 01F1 C2F801    	JNZ	BAD
 01F4 79        	MOV	A,C
 01F5 FE92      	CPI	6+140
 01F7 D0        	RNC
 01F8 117602    BAD:	LXI	D,MBAD
 01FB 37        	STC
 01FC C9        	RET
                ;
 01FD AF        CKSUM:	XRA	A		;A = SUM OF B BYTES AT HL,
 01FE 86        CKS1:	ADD	M		;WITH EACH CARRY ADDED BACK IN
 01FF CE00      	ACI	0
 0201 23        	INX	H
 0202 05        	DCR	B
 0203 C2FE01    	JNZ	CKS1
 0206 C9        	RET
                ;
 0207 F5        PUTC:	PUSH	PSW		;SEND A WHEN THE LATCH IS EMPTY
 0208 CD0F02    	CALL	TXWAIT
 020B F1        	POP	PSW
 020C D3D0      	OUT	PORTA
 020E C9        	RET
 020F 1E80      TXWAIT:	MVI	E,OBF		;WAIT FOR /OBF HIGH
 0211 C31C02    	JMP	PCWAIT
 0214 1E20      GETC:	MVI	E,IBF		;A = THE NEXT BYTE FROM THE ESP32
 0216 CD1C02    	CALL	PCWAIT
 0219 DBD0      	IN	PORTA
 021B C9        	RET
 021C E5        PCWAIT:	PUSH	H		;WAIT UNTIL PORT C HAS BIT E SET,
 021D 214C1D    	LXI	H,TMAX		;FOR UP TO TMAX TICKS. KEEPS BC HL
 0220 3A0B00    	LDA	TICKS
 0223 57        	MOV	D,A		;D = THE TICK WE ARE IN
 0224 DBD2      PCW1:	IN	PORTC
 0226 A3        	ANA	E
 0227 C23B02    	JNZ	PCW2
 022A 3A0B00    	LDA	TICKS		;HAS THE CLOCK TICKED?
 022D BA        	CMP	D
 022E CA2402    	JZ	PCW1
 0231 57        	MOV	D,A		;YES: ONE TICK FEWER LEFT
 0232 2B        	DCX	H
 0233 7C        	MOV	A,H
 0234 B5        	ORA	L
 0235 C22402    	JNZ	PCW1
 0238 C34001    	JMP	TMOUT		;NONE LEFT: GIVE UP
 023B E1        PCW2:	POP	H
 023C C9        	RET
                ;
 023D 7E        PRFLD:	MOV	A,M		;PRINT UP TO B CHARACTERS AT HL,
 023E B7        	ORA	A		;STOPPING AT A NUL
 023F C8        	RZ
 0240 E5        	PUSH	H
 0241 C5        	PUSH	B
 0242 5F        	MOV	E,A
 0243 0E02      	MVI	C,2		;BDOS CONSOLE OUTPUT
 0245 CD0500    	CALL	BDOS
 0248 C1        	POP	B
 0249 E1        	POP	H
 024A 23        	INX	H
 024B 05        	DCR	B
 024C C23D02    	JNZ	PRFLD
 024F C9        	RET
 0250 0E09      PRMSG:	MVI	C,9		;BDOS PRINT STRING, TO THE $
 0252 C30500    	JMP	BDOS
                ;
 0255 70E8060000PKT:	DB	70H,0E8H,6,0,0,0 ;DEV, CMD, LENGTH, CHECKSUM, DESC
 025B 4E6574776FMNET:	DB	'Network:  $'
 0266 0D0A466972MVER:	DB	0DH,0AH,'Firmware: $'
 0273 0D0A24    MEND:	DB	0DH,0AH,'$'
 0276 4261642072MBAD:	DB	'Bad reply',0DH,0AH,'$'
 0282 46756A694EMNAK:	DB	'FujiNet said NAK',0DH,0AH,'$'
 0295 4E6F207265MTIME:	DB	'No reply',0DH,0AH,'$'
 02A0           OLDSP:	DS	2		;THE CCP'S SP
 02A2           REPLY:	DS	RMAX		;THE REPLY PACKET, UNESCAPED
 036A           	DS	64
                STACK:
 03AA           	END	START
