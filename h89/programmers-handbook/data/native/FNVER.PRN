

                ;	FNVER.ASM - ask the H89 FujiNet for its firmware version
                ;
                ;	Sets up the card's 82C55, sends FUJI_GET_ADAPTERCONFIG
                ;	(device 70H, command 0E8H) in a SLIP frame, checks the reply
                ;	and prints the network name and firmware version. Pure 8080.
                ;
                ;	A>ASM B:FNVER
                ;	A>LOAD B:FNVER
                ;	A>B:FNVER
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D2 =         PORTC	EQU	0D2H		;STATUS IN, PC0-PC2 OUT
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 0080 =         OBF	EQU	80H		;PC7 /OBF: 1 = OUR LAST BYTE WAS TAKEN
 0020 =         IBF	EQU	20H		;PC5 IBF: 1 = A BYTE WAITS FOR US
 000B =         TICKS	EQU	000BH		;HEATH BIOS 2 MS CLOCK
 1D4C =         TMAX	EQU	7500		;GIVE UP AFTER 15 S (7500 TICKS)
 0005 =         BDOS	EQU	0005H
 00C0 =         SLEND	EQU	0C0H		;SLIP END: FRAMES A PACKET
 00DB =         SLESC	EQU	0DBH		;SLIP ESC
 00DC =         ESCEND	EQU	0DCH		;DB DC STANDS FOR A C0H
 00DD =         ESCESC	EQU	0DDH		;DB DD STANDS FOR A DBH
 00C8 =         RMAX	EQU	200		;REPLY BUFFER SIZE
                ;
 0100           	ORG	0100H
                ;
 0100 210000    START:	LXI	H,0		;KEEP THE CCP'S STACK POINTER
 0103 39        	DAD	SP
 0104 22AC02    	SHLD	OLDSP
 0107 31B603    	LXI	SP,STACK	;AND USE OUR OWN
 010A CD4A01    	CALL	CARDON		;SET UP THE CARD
 010D CD5101    	CALL	SENDRQ		;SEND THE REQUEST
 0110 CD9401    	CALL	RECV		;TAKE THE REPLY
 0113 CDCD01    	CALL	CHECK		;CARRY: DE -> WHAT WAS WRONG
 0116 DA3801    	JC	EXIT
 0119 116702    	LXI	D,MNET
 011C CD5C02    	CALL	PRMSG
 011F 21B402    	LXI	H,REPLY+6	;SSID: OFFSET 0, 33 BYTES
 0122 0621      	MVI	B,33
 0124 CD4902    	CALL	PRFLD
 0127 117202    	LXI	D,MVER
 012A CD5C02    	CALL	PRMSG
 012D 213103    	LXI	H,REPLY+6+125	;FN_VERSION: OFFSET 125, 15 BYTES
 0130 060F      	MVI	B,15
 0132 CD4902    	CALL	PRFLD
 0135 117F02    	LXI	D,MEND
 0138 CD5C02    EXIT:	CALL	PRMSG
 013B 2AAC02    	LHLD	OLDSP		;BACK TO THE CCP
 013E F9        	SPHL
 013F C9        	RET
 0140 3E00      TMOUT:	MVI	A,00H		;NO ANSWER: PC0=0, BUS TO THE H89
 0142 D3D3      	OUT	PCTRL
 0144 11A102    	LXI	D,MTIME
 0147 C33801    	JMP	EXIT		;(EXIT RESETS SP)
                ;
 014A 3EC0      CARDON:	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS, ALL 0:
 014C D3D3      	OUT	PCTRL		;THE 245 ON AND DRIVING TOWARD THE H89
 014E DBD0      	IN	PORTA		;DROP ANY BYTE LATCHED BEFORE
 0150 C9        	RET
                ;
 0151 216102    SENDRQ:	LXI	H,PKT		;CHECKSUM THE PACKET, BYTE 4 AS 0
 0154 0606      	MVI	B,6
 0156 CD0902    	CALL	CKSUM
 0159 326502    	STA	PKT+4
 015C 3E01      	MVI	A,01H		;PC0=1: 245 DRIVES TOWARD THE ESP32
 015E D3D3      	OUT	PCTRL
 0160 3EC0      	MVI	A,SLEND		;ONE END BEFORE THE PACKET
 0162 CD1302    	CALL	PUTC
 0165 216102    	LXI	H,PKT
 0168 0606      	MVI	B,6
 016A 7E        SEND1:	MOV	A,M
 016B FEC0      	CPI	SLEND		;C0H GOES AS DB DC,
 016D 0EDC      	MVI	C,ESCEND	;(MVI LEAVES THE FLAGS ALONE)
 016F CA7901    	JZ	SEND2
 0172 FEDB      	CPI	SLESC		;DBH AS DB DD
 0174 0EDD      	MVI	C,ESCESC
 0176 C27F01    	JNZ	SEND3
 0179 3EDB      SEND2:	MVI	A,SLESC
 017B CD1302    	CALL	PUTC
 017E 79        	MOV	A,C
 017F CD1302    SEND3:	CALL	PUTC
 0182 23        	INX	H
 0183 05        	DCR	B
 0184 C26A01    	JNZ	SEND1
 0187 3EC0      	MVI	A,SLEND		;ONE END AFTER IT
 0189 CD1302    	CALL	PUTC
 018C CD1B02    	CALL	TXWAIT		;UNTIL THE ESP32 HAS IT ALL
 018F 3E00      	MVI	A,00H		;PC0=0: BACK TOWARD THE H89
 0191 D3D3      	OUT	PCTRL
 0193 C9        	RET
                ;
 0194 CD2002    RECV:	CALL	GETC		;WAIT FOR AN END,
 0197 FEC0      	CPI	SLEND
 0199 C29401    	JNZ	RECV
 019C CD2002    RECV1:	CALL	GETC		;SKIP ANY MORE
 019F FEC0      	CPI	SLEND
 01A1 CA9C01    	JZ	RECV1
 01A4 21AE02    	LXI	H,REPLY		;HL -> BUFFER, C = BYTES KEPT
 01A7 0E00      	MVI	C,0
 01A9 FEC0      RECV2:	CPI	SLEND		;THE CLOSING END: DONE
 01AB C8        	RZ
 01AC FEDB      	CPI	SLESC		;ESC: THE NEXT BYTE SAYS WHICH
 01AE C2BD01    	JNZ	RECV3
 01B1 CD2002    	CALL	GETC
 01B4 FEDC      	CPI	ESCEND		;DB DC WAS A C0H,
 01B6 3EC0      	MVI	A,SLEND
 01B8 CABD01    	JZ	RECV3
 01BB 3EDB      	MVI	A,SLESC		;DB DD A DBH
 01BD 47        RECV3:	MOV	B,A		;KEEP IT IF THERE IS ROOM
 01BE 79        	MOV	A,C
 01BF FEC8      	CPI	RMAX
 01C1 D2C701    	JNC	RECV4
 01C4 70        	MOV	M,B
 01C5 23        	INX	H
 01C6 0C        	INR	C
 01C7 CD2002    RECV4:	CALL	GETC
 01CA C3A901    	JMP	RECV2
                ;
 01CD 79        CHECK:	MOV	A,C		;A HEADER AT LEAST
 01CE FE06      	CPI	6
 01D0 DA0402    	JC	BAD
 01D3 2AB002    	LHLD	REPLY+2		;LENGTH WORD = BYTES RECEIVED
 01D6 7C        	MOV	A,H
 01D7 B7        	ORA	A
 01D8 C20402    	JNZ	BAD
 01DB 7D        	MOV	A,L
 01DC B9        	CMP	C
 01DD C20402    	JNZ	BAD
 01E0 21B202    	LXI	H,REPLY+4	;CHECKSUM: ITS OWN BYTE COUNTS AS 0
 01E3 5E        	MOV	E,M
 01E4 3600      	MVI	M,0
 01E6 21AE02    	LXI	H,REPLY
 01E9 41        	MOV	B,C
 01EA CD0902    	CALL	CKSUM
 01ED BB        	CMP	E
 01EE C20402    	JNZ	BAD
 01F1 118E02    	LXI	D,MNAK
 01F4 3AAF02    	LDA	REPLY+1
 01F7 FE15      	CPI	15H		;NAK: THE FUJINET SAID NO
 01F9 37        	STC
 01FA C8        	RZ
 01FB FE06      	CPI	06H		;ACK, WITH ALL 140 BYTES
 01FD C20402    	JNZ	BAD
 0200 79        	MOV	A,C
 0201 FE92      	CPI	6+140
 0203 D0        	RNC
 0204 118202    BAD:	LXI	D,MBAD
 0207 37        	STC
 0208 C9        	RET
                ;
 0209 AF        CKSUM:	XRA	A		;A = SUM OF B BYTES AT HL,
 020A 86        CKS1:	ADD	M		;WITH EACH CARRY ADDED BACK IN
 020B CE00      	ACI	0
 020D 23        	INX	H
 020E 05        	DCR	B
 020F C20A02    	JNZ	CKS1
 0212 C9        	RET
                ;
 0213 F5        PUTC:	PUSH	PSW		;SEND A WHEN THE LATCH IS EMPTY
 0214 CD1B02    	CALL	TXWAIT
 0217 F1        	POP	PSW
 0218 D3D0      	OUT	PORTA
 021A C9        	RET
 021B 1E80      TXWAIT:	MVI	E,OBF		;WAIT FOR /OBF HIGH
 021D C32802    	JMP	PCWAIT
 0220 1E20      GETC:	MVI	E,IBF		;A = THE NEXT BYTE FROM THE ESP32
 0222 CD2802    	CALL	PCWAIT
 0225 DBD0      	IN	PORTA
 0227 C9        	RET
 0228 E5        PCWAIT:	PUSH	H		;WAIT UNTIL PORT C HAS BIT E SET,
 0229 214C1D    	LXI	H,TMAX		;FOR UP TO TMAX TICKS. KEEPS BC HL
 022C 3A0B00    	LDA	TICKS
 022F 57        	MOV	D,A		;D = THE TICK WE ARE IN
 0230 DBD2      PCW1:	IN	PORTC
 0232 A3        	ANA	E
 0233 C24702    	JNZ	PCW2
 0236 3A0B00    	LDA	TICKS		;HAS THE CLOCK TICKED?
 0239 BA        	CMP	D
 023A CA3002    	JZ	PCW1
 023D 57        	MOV	D,A		;YES: ONE TICK FEWER LEFT
 023E 2B        	DCX	H
 023F 7C        	MOV	A,H
 0240 B5        	ORA	L
 0241 C23002    	JNZ	PCW1
 0244 C34001    	JMP	TMOUT		;NONE LEFT: GIVE UP
 0247 E1        PCW2:	POP	H
 0248 C9        	RET
                ;
 0249 7E        PRFLD:	MOV	A,M		;PRINT UP TO B CHARACTERS AT HL,
 024A B7        	ORA	A		;STOPPING AT A NUL
 024B C8        	RZ
 024C E5        	PUSH	H
 024D C5        	PUSH	B
 024E 5F        	MOV	E,A
 024F 0E02      	MVI	C,2		;BDOS CONSOLE OUTPUT
 0251 CD0500    	CALL	BDOS
 0254 C1        	POP	B
 0255 E1        	POP	H
 0256 23        	INX	H
 0257 05        	DCR	B
 0258 C24902    	JNZ	PRFLD
 025B C9        	RET
 025C 0E09      PRMSG:	MVI	C,9		;BDOS PRINT STRING, TO THE $
 025E C30500    	JMP	BDOS
                ;
 0261 70E8060000PKT:	DB	70H,0E8H,6,0,0,0 ;DEV, CMD, LENGTH, CHECKSUM, DESC
 0267 4E6574776FMNET:	DB	'Network:  $'
 0272 0D0A466972MVER:	DB	0DH,0AH,'Firmware: $'
 027F 0D0A24    MEND:	DB	0DH,0AH,'$'
 0282 4261642072MBAD:	DB	'Bad reply',0DH,0AH,'$'
 028E 46756A694EMNAK:	DB	'FujiNet said NAK',0DH,0AH,'$'
 02A1 4E6F207265MTIME:	DB	'No reply',0DH,0AH,'$'
 02AC           OLDSP:	DS	2		;THE CCP'S SP
 02AE           REPLY:	DS	RMAX		;THE REPLY PACKET, UNESCAPED
 0376           	DS	64
                STACK:
 03B6           	END	START
