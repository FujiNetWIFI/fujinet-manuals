

                ;	FNVER.ASM - ask the H89 FujiNet for its firmware version
                ;
                ;	Starts the card if nothing has, sends FUJI_GET_ADAPTERCONFIG
                ;	(device 70H, command 0E8H) in a SLIP frame, checks the reply
                ;	and prints the network name and firmware version. Pure 8080.
                ;
                ;	A>ASM B:FNVER
                ;	A>LOAD B:FNVER
                ;	A>B:FNVER
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D2 =         PORTC	EQU	0D2H		;STATUS IN, PC0-PC2 OUT
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 0080 =         OBF	EQU	80H		;PC7 /OBF: 1 = OUR LAST BYTE WAS TAKEN
 0020 =         IBF	EQU	20H		;PC5 IBF: 1 = A BYTE WAITS FOR US
 000B =         TICKS	EQU	000BH		;HEATH BIOS 2 MS CLOCK
 1D4C =         TMAX	EQU	7500		;GIVE UP AFTER 15 S (7500 TICKS)
 0005 =         BDOS	EQU	0005H
 00C0 =         SLEND	EQU	0C0H		;SLIP END: FRAMES A PACKET
 00DB =         SLESC	EQU	0DBH		;SLIP ESC
 00DC =         ESCEND	EQU	0DCH		;DB DC STANDS FOR A C0H
 00DD =         ESCESC	EQU	0DDH		;DB DD STANDS FOR A DBH
 00C8 =         RMAX	EQU	200		;REPLY BUFFER SIZE
                ;
 0100           	ORG	0100H
                ;
 0100 210000    START:	LXI	H,0		;KEEP THE CCP'S STACK POINTER
 0103 39        	DAD	SP
 0104 22DA02    	SHLD	OLDSP
 0107 31E403    	LXI	SP,STACK	;AND USE OUR OWN
 010A CD4A01    	CALL	CARDON		;START THE CARD IF IT IS OFF
 010D CD7F01    	CALL	SENDRQ		;SEND THE REQUEST
 0110 CDC201    	CALL	RECV		;TAKE THE REPLY
 0113 CDFB01    	CALL	CHECK		;CARRY: DE -> WHAT WAS WRONG
 0116 DA3801    	JC	EXIT
 0119 119502    	LXI	D,MNET
 011C CD8A02    	CALL	PRMSG
 011F 21E202    	LXI	H,REPLY+6	;SSID: OFFSET 0, 33 BYTES
 0122 0621      	MVI	B,33
 0124 CD7702    	CALL	PRFLD
 0127 11A002    	LXI	D,MVER
 012A CD8A02    	CALL	PRMSG
 012D 215F03    	LXI	H,REPLY+6+125	;FN_VERSION: OFFSET 125, 15 BYTES
 0130 060F      	MVI	B,15
 0132 CD7702    	CALL	PRFLD
 0135 11AD02    	LXI	D,MEND
 0138 CD8A02    EXIT:	CALL	PRMSG
 013B 2ADA02    	LHLD	OLDSP		;BACK TO THE CCP
 013E F9        	SPHL
 013F C9        	RET
 0140 3E00      TMOUT:	MVI	A,00H		;NO ANSWER: PC0=0, BUS TO THE H89
 0142 D3D3      	OUT	PCTRL
 0144 11CF02    	LXI	D,MTIME
 0147 C33801    	JMP	EXIT		;(EXIT RESETS SP)
                ;
 014A DBD2      CARDON:	IN	PORTC
 014C E604      	ANI	04H		;EN HIGH: CARD ALREADY RUNNING
 014E C26D01    	JNZ	CREADY
 0151 3EC0      	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS
 0153 D3D3      	OUT	PCTRL		;(CLEARS PORT C, SO EN GOES LOW)
 0155 3E06      	MVI	A,06H		;EN=1, IO0=1
 0157 D3D2      	OUT	PORTC
 0159 3E02      	MVI	A,02H		;EN=0 WITH IO0 ALREADY HIGH
 015B D3D2      	OUT	PORTC
 015D 016400    	LXI	B,100		;HOLD RESET ABOUT 1 MS
 0160 CD7801    	CALL	WAIT
 0163 3E06      	MVI	A,06H		;EN=1: IO0 HIGH = BOOT FROM FLASH
 0165 D3D2      	OUT	PORTC
 0167 016842    	LXI	B,17000		;KEEP IO0 HIGH WHILE IT STARTS, ~200 MS
 016A CD7801    	CALL	WAIT
 016D DBD0      CREADY:	IN	PORTA		;DROP ANY BYTE LATCHED DURING RESET
 016F 3E02      	MVI	A,02H		;PC1=0: ENABLE THE 245
 0171 D3D3      	OUT	PCTRL
 0173 3E00      	MVI	A,00H		;PC0=0: 245 DRIVES TOWARD THE H89
 0175 D3D3      	OUT	PCTRL
 0177 C9        	RET
 0178 0B        WAIT:	DCX	B		;ABOUT 12 US A PASS AT 2 MHZ
 0179 78        	MOV	A,B
 017A B1        	ORA	C
 017B C27801    	JNZ	WAIT
 017E C9        	RET
                ;
 017F 218F02    SENDRQ:	LXI	H,PKT		;CHECKSUM THE PACKET, BYTE 4 AS 0
 0182 0606      	MVI	B,6
 0184 CD3702    	CALL	CKSUM
 0187 329302    	STA	PKT+4
 018A 3E01      	MVI	A,01H		;PC0=1: 245 DRIVES TOWARD THE ESP32
 018C D3D3      	OUT	PCTRL
 018E 3EC0      	MVI	A,SLEND		;ONE END BEFORE THE PACKET
 0190 CD4102    	CALL	PUTC
 0193 218F02    	LXI	H,PKT
 0196 0606      	MVI	B,6
 0198 7E        SEND1:	MOV	A,M
 0199 FEC0      	CPI	SLEND		;C0H GOES AS DB DC,
 019B 0EDC      	MVI	C,ESCEND	;(MVI LEAVES THE FLAGS ALONE)
 019D CAA701    	JZ	SEND2
 01A0 FEDB      	CPI	SLESC		;DBH AS DB DD
 01A2 0EDD      	MVI	C,ESCESC
 01A4 C2AD01    	JNZ	SEND3
 01A7 3EDB      SEND2:	MVI	A,SLESC
 01A9 CD4102    	CALL	PUTC
 01AC 79        	MOV	A,C
 01AD CD4102    SEND3:	CALL	PUTC
 01B0 23        	INX	H
 01B1 05        	DCR	B
 01B2 C29801    	JNZ	SEND1
 01B5 3EC0      	MVI	A,SLEND		;ONE END AFTER IT
 01B7 CD4102    	CALL	PUTC
 01BA CD4902    	CALL	TXWAIT		;UNTIL THE ESP32 HAS IT ALL
 01BD 3E00      	MVI	A,00H		;PC0=0: BACK TOWARD THE H89
 01BF D3D3      	OUT	PCTRL
 01C1 C9        	RET
                ;
 01C2 CD4E02    RECV:	CALL	GETC		;WAIT FOR AN END,
 01C5 FEC0      	CPI	SLEND
 01C7 C2C201    	JNZ	RECV
 01CA CD4E02    RECV1:	CALL	GETC		;SKIP ANY MORE
 01CD FEC0      	CPI	SLEND
 01CF CACA01    	JZ	RECV1
 01D2 21DC02    	LXI	H,REPLY		;HL -> BUFFER, C = BYTES KEPT
 01D5 0E00      	MVI	C,0
 01D7 FEC0      RECV2:	CPI	SLEND		;THE CLOSING END: DONE
 01D9 C8        	RZ
 01DA FEDB      	CPI	SLESC		;ESC: THE NEXT BYTE SAYS WHICH
 01DC C2EB01    	JNZ	RECV3
 01DF CD4E02    	CALL	GETC
 01E2 FEDC      	CPI	ESCEND		;DB DC WAS A C0H,
 01E4 3EC0      	MVI	A,SLEND
 01E6 CAEB01    	JZ	RECV3
 01E9 3EDB      	MVI	A,SLESC		;DB DD A DBH
 01EB 47        RECV3:	MOV	B,A		;KEEP IT IF THERE IS ROOM
 01EC 79        	MOV	A,C
 01ED FEC8      	CPI	RMAX
 01EF D2F501    	JNC	RECV4
 01F2 70        	MOV	M,B
 01F3 23        	INX	H
 01F4 0C        	INR	C
 01F5 CD4E02    RECV4:	CALL	GETC
 01F8 C3D701    	JMP	RECV2
                ;
 01FB 79        CHECK:	MOV	A,C		;A HEADER AT LEAST
 01FC FE06      	CPI	6
 01FE DA3202    	JC	BAD
 0201 2ADE02    	LHLD	REPLY+2		;LENGTH WORD = BYTES RECEIVED
 0204 7C        	MOV	A,H
 0205 B7        	ORA	A
 0206 C23202    	JNZ	BAD
 0209 7D        	MOV	A,L
 020A B9        	CMP	C
 020B C23202    	JNZ	BAD
 020E 21E002    	LXI	H,REPLY+4	;CHECKSUM: ITS OWN BYTE COUNTS AS 0
 0211 5E        	MOV	E,M
 0212 3600      	MVI	M,0
 0214 21DC02    	LXI	H,REPLY
 0217 41        	MOV	B,C
 0218 CD3702    	CALL	CKSUM
 021B BB        	CMP	E
 021C C23202    	JNZ	BAD
 021F 11BC02    	LXI	D,MNAK
 0222 3ADD02    	LDA	REPLY+1
 0225 FE15      	CPI	15H		;NAK: THE FUJINET SAID NO
 0227 37        	STC
 0228 C8        	RZ
 0229 FE06      	CPI	06H		;ACK, WITH ALL 140 BYTES
 022B C23202    	JNZ	BAD
 022E 79        	MOV	A,C
 022F FE92      	CPI	6+140
 0231 D0        	RNC
 0232 11B002    BAD:	LXI	D,MBAD
 0235 37        	STC
 0236 C9        	RET
                ;
 0237 AF        CKSUM:	XRA	A		;A = SUM OF B BYTES AT HL,
 0238 86        CKS1:	ADD	M		;WITH EACH CARRY ADDED BACK IN
 0239 CE00      	ACI	0
 023B 23        	INX	H
 023C 05        	DCR	B
 023D C23802    	JNZ	CKS1
 0240 C9        	RET
                ;
 0241 F5        PUTC:	PUSH	PSW		;SEND A WHEN THE LATCH IS EMPTY
 0242 CD4902    	CALL	TXWAIT
 0245 F1        	POP	PSW
 0246 D3D0      	OUT	PORTA
 0248 C9        	RET
 0249 1E80      TXWAIT:	MVI	E,OBF		;WAIT FOR /OBF HIGH
 024B C35602    	JMP	PCWAIT
 024E 1E20      GETC:	MVI	E,IBF		;A = THE NEXT BYTE FROM THE ESP32
 0250 CD5602    	CALL	PCWAIT
 0253 DBD0      	IN	PORTA
 0255 C9        	RET
 0256 E5        PCWAIT:	PUSH	H		;WAIT UNTIL PORT C HAS BIT E SET,
 0257 214C1D    	LXI	H,TMAX		;FOR UP TO TMAX TICKS. KEEPS BC HL
 025A 3A0B00    	LDA	TICKS
 025D 57        	MOV	D,A		;D = THE TICK WE ARE IN
 025E DBD2      PCW1:	IN	PORTC
 0260 A3        	ANA	E
 0261 C27502    	JNZ	PCW2
 0264 3A0B00    	LDA	TICKS		;HAS THE CLOCK TICKED?
 0267 BA        	CMP	D
 0268 CA5E02    	JZ	PCW1
 026B 57        	MOV	D,A		;YES: ONE TICK FEWER LEFT
 026C 2B        	DCX	H
 026D 7C        	MOV	A,H
 026E B5        	ORA	L
 026F C25E02    	JNZ	PCW1
 0272 C34001    	JMP	TMOUT		;NONE LEFT: GIVE UP
 0275 E1        PCW2:	POP	H
 0276 C9        	RET
                ;
 0277 7E        PRFLD:	MOV	A,M		;PRINT UP TO B CHARACTERS AT HL,
 0278 B7        	ORA	A		;STOPPING AT A NUL
 0279 C8        	RZ
 027A E5        	PUSH	H
 027B C5        	PUSH	B
 027C 5F        	MOV	E,A
 027D 0E02      	MVI	C,2		;BDOS CONSOLE OUTPUT
 027F CD0500    	CALL	BDOS
 0282 C1        	POP	B
 0283 E1        	POP	H
 0284 23        	INX	H
 0285 05        	DCR	B
 0286 C27702    	JNZ	PRFLD
 0289 C9        	RET
 028A 0E09      PRMSG:	MVI	C,9		;BDOS PRINT STRING, TO THE $
 028C C30500    	JMP	BDOS
                ;
 028F 70E8060000PKT:	DB	70H,0E8H,6,0,0,0 ;DEV, CMD, LENGTH, CHECKSUM, DESC
 0295 4E6574776FMNET:	DB	'Network:  $'
 02A0 0D0A466972MVER:	DB	0DH,0AH,'Firmware: $'
 02AD 0D0A24    MEND:	DB	0DH,0AH,'$'
 02B0 4261642072MBAD:	DB	'Bad reply',0DH,0AH,'$'
 02BC 46756A694EMNAK:	DB	'FujiNet said NAK',0DH,0AH,'$'
 02CF 4E6F207265MTIME:	DB	'No reply',0DH,0AH,'$'
 02DA           OLDSP:	DS	2		;THE CCP'S SP
 02DC           REPLY:	DS	RMAX		;THE REPLY PACKET, UNESCAPED
 03A4           	DS	64
                STACK:
 03E4           	END	START
