

                ;	FNVER.ASM - ask the H89 FujiNet for its firmware version
                ;
                ;	Starts the card if nothing has, sends FUJI_GET_ADAPTERCONFIG
                ;	(device 70H, command 0E8H) in a SLIP frame, checks the reply
                ;	and prints the network name and firmware version. Pure 8080.
                ;
                ;	A>ASM B:FNVER
                ;	A>LOAD B:FNVER
                ;	A>B:FNVER
                ;
                ;	Copyright (C) 2026 Thomas Cherryhomes
                ;	SPDX-License-Identifier: GPL-3.0-or-later
                ;
 00D0 =         PORTA	EQU	0D0H		;82C55 PORT A, THE BYTE PIPE
 00D1 =         PORTB	EQU	0D1H		;WIRED TO NOTHING: HOLDS MARK ONCE SET UP
 00D2 =         PORTC	EQU	0D2H		;STATUS IN, PC0-PC2 OUT
 00D3 =         PCTRL	EQU	0D3H		;CONTROL WORD, PORT C BIT SET/RESET
 00A5 =         MARK	EQU	0A5H		;AS FUJINET-LIB'S PORT_INIT LEAVES IT
 0080 =         OBF	EQU	80H		;PC7 /OBF: 1 = OUR LAST BYTE WAS TAKEN
 0020 =         IBF	EQU	20H		;PC5 IBF: 1 = A BYTE WAITS FOR US
 000B =         TICKS	EQU	000BH		;HEATH BIOS 2 MS CLOCK
 1D4C =         TMAX	EQU	7500		;GIVE UP AFTER 15 S (7500 TICKS)
 0005 =         BDOS	EQU	0005H
 00C0 =         SLEND	EQU	0C0H		;SLIP END: FRAMES A PACKET
 00DB =         SLESC	EQU	0DBH		;SLIP ESC
 00DC =         ESCEND	EQU	0DCH		;DB DC STANDS FOR A C0H
 00DD =         ESCESC	EQU	0DDH		;DB DD STANDS FOR A DBH
 00C8 =         RMAX	EQU	200		;REPLY BUFFER SIZE
                ;
 0100           	ORG	0100H
                ;
 0100 210000    START:	LXI	H,0		;KEEP THE CCP'S STACK POINTER
 0103 39        	DAD	SP
 0104 22D702    	SHLD	OLDSP
 0107 31E103    	LXI	SP,STACK	;AND USE OUR OWN
 010A CD4A01    	CALL	CARDON		;START THE CARD IF IT IS OFF
 010D CD7C01    	CALL	SENDRQ		;SEND THE REQUEST
 0110 CDBF01    	CALL	RECV		;TAKE THE REPLY
 0113 CDF801    	CALL	CHECK		;CARRY: DE -> WHAT WAS WRONG
 0116 DA3801    	JC	EXIT
 0119 119202    	LXI	D,MNET
 011C CD8702    	CALL	PRMSG
 011F 21DF02    	LXI	H,REPLY+6	;SSID: OFFSET 0, 33 BYTES
 0122 0621      	MVI	B,33
 0124 CD7402    	CALL	PRFLD
 0127 119D02    	LXI	D,MVER
 012A CD8702    	CALL	PRMSG
 012D 215C03    	LXI	H,REPLY+6+125	;FN_VERSION: OFFSET 125, 15 BYTES
 0130 060F      	MVI	B,15
 0132 CD7402    	CALL	PRFLD
 0135 11AA02    	LXI	D,MEND
 0138 CD8702    EXIT:	CALL	PRMSG
 013B 2AD702    	LHLD	OLDSP		;BACK TO THE CCP
 013E F9        	SPHL
 013F C9        	RET
 0140 3E00      TMOUT:	MVI	A,00H		;NO ANSWER: PC0=0, BUS TO THE H89
 0142 D3D3      	OUT	PCTRL
 0144 11CC02    	LXI	D,MTIME
 0147 C33801    	JMP	EXIT		;(EXIT RESETS SP)
                ;
 014A DBD1      CARDON:	IN	PORTB
 014C FEA5      	CPI	MARK		;MARK AND EN HIGH: CARD ALREADY RUNNING
 014E C25801    	JNZ	CSTART
 0151 DBD2      	IN	PORTC
 0153 E604      	ANI	04H
 0155 C26A01    	JNZ	CREADY
 0158 3EC0      CSTART:	MVI	A,0C0H		;PORT A MODE 2, PC0-PC2 OUTPUTS
 015A D3D3      	OUT	PCTRL		;(CLEARS PORT C, SO EN GOES LOW)
 015C 3E06      	MVI	A,06H		;EN=1, IO0=1 AT ONCE: A RUNNING ESP32
 015E D3D2      	OUT	PORTC		;STAYS UP, ONE IN RESET BOOTS FROM FLASH
 0160 016842    	LXI	B,17000		;KEEP IO0 HIGH WHILE IT STARTS, ~200 MS
 0163 CD7501    	CALL	WAIT
 0166 3EA5      	MVI	A,MARK		;THE CARD IS SET UP
 0168 D3D1      	OUT	PORTB
 016A DBD0      CREADY:	IN	PORTA		;DROP ANY BYTE LATCHED DURING RESET
 016C 3E02      	MVI	A,02H		;PC1=0: ENABLE THE 245
 016E D3D3      	OUT	PCTRL
 0170 3E00      	MVI	A,00H		;PC0=0: 245 DRIVES TOWARD THE H89
 0172 D3D3      	OUT	PCTRL
 0174 C9        	RET
 0175 0B        WAIT:	DCX	B		;ABOUT 12 US A PASS AT 2 MHZ
 0176 78        	MOV	A,B
 0177 B1        	ORA	C
 0178 C27501    	JNZ	WAIT
 017B C9        	RET
                ;
 017C 218C02    SENDRQ:	LXI	H,PKT		;CHECKSUM THE PACKET, BYTE 4 AS 0
 017F 0606      	MVI	B,6
 0181 CD3402    	CALL	CKSUM
 0184 329002    	STA	PKT+4
 0187 3E01      	MVI	A,01H		;PC0=1: 245 DRIVES TOWARD THE ESP32
 0189 D3D3      	OUT	PCTRL
 018B 3EC0      	MVI	A,SLEND		;ONE END BEFORE THE PACKET
 018D CD3E02    	CALL	PUTC
 0190 218C02    	LXI	H,PKT
 0193 0606      	MVI	B,6
 0195 7E        SEND1:	MOV	A,M
 0196 FEC0      	CPI	SLEND		;C0H GOES AS DB DC,
 0198 0EDC      	MVI	C,ESCEND	;(MVI LEAVES THE FLAGS ALONE)
 019A CAA401    	JZ	SEND2
 019D FEDB      	CPI	SLESC		;DBH AS DB DD
 019F 0EDD      	MVI	C,ESCESC
 01A1 C2AA01    	JNZ	SEND3
 01A4 3EDB      SEND2:	MVI	A,SLESC
 01A6 CD3E02    	CALL	PUTC
 01A9 79        	MOV	A,C
 01AA CD3E02    SEND3:	CALL	PUTC
 01AD 23        	INX	H
 01AE 05        	DCR	B
 01AF C29501    	JNZ	SEND1
 01B2 3EC0      	MVI	A,SLEND		;ONE END AFTER IT
 01B4 CD3E02    	CALL	PUTC
 01B7 CD4602    	CALL	TXWAIT		;UNTIL THE ESP32 HAS IT ALL
 01BA 3E00      	MVI	A,00H		;PC0=0: BACK TOWARD THE H89
 01BC D3D3      	OUT	PCTRL
 01BE C9        	RET
                ;
 01BF CD4B02    RECV:	CALL	GETC		;WAIT FOR AN END,
 01C2 FEC0      	CPI	SLEND
 01C4 C2BF01    	JNZ	RECV
 01C7 CD4B02    RECV1:	CALL	GETC		;SKIP ANY MORE
 01CA FEC0      	CPI	SLEND
 01CC CAC701    	JZ	RECV1
 01CF 21D902    	LXI	H,REPLY		;HL -> BUFFER, C = BYTES KEPT
 01D2 0E00      	MVI	C,0
 01D4 FEC0      RECV2:	CPI	SLEND		;THE CLOSING END: DONE
 01D6 C8        	RZ
 01D7 FEDB      	CPI	SLESC		;ESC: THE NEXT BYTE SAYS WHICH
 01D9 C2E801    	JNZ	RECV3
 01DC CD4B02    	CALL	GETC
 01DF FEDC      	CPI	ESCEND		;DB DC WAS A C0H,
 01E1 3EC0      	MVI	A,SLEND
 01E3 CAE801    	JZ	RECV3
 01E6 3EDB      	MVI	A,SLESC		;DB DD A DBH
 01E8 47        RECV3:	MOV	B,A		;KEEP IT IF THERE IS ROOM
 01E9 79        	MOV	A,C
 01EA FEC8      	CPI	RMAX
 01EC D2F201    	JNC	RECV4
 01EF 70        	MOV	M,B
 01F0 23        	INX	H
 01F1 0C        	INR	C
 01F2 CD4B02    RECV4:	CALL	GETC
 01F5 C3D401    	JMP	RECV2
                ;
 01F8 79        CHECK:	MOV	A,C		;A HEADER AT LEAST
 01F9 FE06      	CPI	6
 01FB DA2F02    	JC	BAD
 01FE 2ADB02    	LHLD	REPLY+2		;LENGTH WORD = BYTES RECEIVED
 0201 7C        	MOV	A,H
 0202 B7        	ORA	A
 0203 C22F02    	JNZ	BAD
 0206 7D        	MOV	A,L
 0207 B9        	CMP	C
 0208 C22F02    	JNZ	BAD
 020B 21DD02    	LXI	H,REPLY+4	;CHECKSUM: ITS OWN BYTE COUNTS AS 0
 020E 5E        	MOV	E,M
 020F 3600      	MVI	M,0
 0211 21D902    	LXI	H,REPLY
 0214 41        	MOV	B,C
 0215 CD3402    	CALL	CKSUM
 0218 BB        	CMP	E
 0219 C22F02    	JNZ	BAD
 021C 11B902    	LXI	D,MNAK
 021F 3ADA02    	LDA	REPLY+1
 0222 FE15      	CPI	15H		;NAK: THE FUJINET SAID NO
 0224 37        	STC
 0225 C8        	RZ
 0226 FE06      	CPI	06H		;ACK, WITH ALL 140 BYTES
 0228 C22F02    	JNZ	BAD
 022B 79        	MOV	A,C
 022C FE92      	CPI	6+140
 022E D0        	RNC
 022F 11AD02    BAD:	LXI	D,MBAD
 0232 37        	STC
 0233 C9        	RET
                ;
 0234 AF        CKSUM:	XRA	A		;A = SUM OF B BYTES AT HL,
 0235 86        CKS1:	ADD	M		;WITH EACH CARRY ADDED BACK IN
 0236 CE00      	ACI	0
 0238 23        	INX	H
 0239 05        	DCR	B
 023A C23502    	JNZ	CKS1
 023D C9        	RET
                ;
 023E F5        PUTC:	PUSH	PSW		;SEND A WHEN THE LATCH IS EMPTY
 023F CD4602    	CALL	TXWAIT
 0242 F1        	POP	PSW
 0243 D3D0      	OUT	PORTA
 0245 C9        	RET
 0246 1E80      TXWAIT:	MVI	E,OBF		;WAIT FOR /OBF HIGH
 0248 C35302    	JMP	PCWAIT
 024B 1E20      GETC:	MVI	E,IBF		;A = THE NEXT BYTE FROM THE ESP32
 024D CD5302    	CALL	PCWAIT
 0250 DBD0      	IN	PORTA
 0252 C9        	RET
 0253 E5        PCWAIT:	PUSH	H		;WAIT UNTIL PORT C HAS BIT E SET,
 0254 214C1D    	LXI	H,TMAX		;FOR UP TO TMAX TICKS. KEEPS BC HL
 0257 3A0B00    	LDA	TICKS
 025A 57        	MOV	D,A		;D = THE TICK WE ARE IN
 025B DBD2      PCW1:	IN	PORTC
 025D A3        	ANA	E
 025E C27202    	JNZ	PCW2
 0261 3A0B00    	LDA	TICKS		;HAS THE CLOCK TICKED?
 0264 BA        	CMP	D
 0265 CA5B02    	JZ	PCW1
 0268 57        	MOV	D,A		;YES: ONE TICK FEWER LEFT
 0269 2B        	DCX	H
 026A 7C        	MOV	A,H
 026B B5        	ORA	L
 026C C25B02    	JNZ	PCW1
 026F C34001    	JMP	TMOUT		;NONE LEFT: GIVE UP
 0272 E1        PCW2:	POP	H
 0273 C9        	RET
                ;
 0274 7E        PRFLD:	MOV	A,M		;PRINT UP TO B CHARACTERS AT HL,
 0275 B7        	ORA	A		;STOPPING AT A NUL
 0276 C8        	RZ
 0277 E5        	PUSH	H
 0278 C5        	PUSH	B
 0279 5F        	MOV	E,A
 027A 0E02      	MVI	C,2		;BDOS CONSOLE OUTPUT
 027C CD0500    	CALL	BDOS
 027F C1        	POP	B
 0280 E1        	POP	H
 0281 23        	INX	H
 0282 05        	DCR	B
 0283 C27402    	JNZ	PRFLD
 0286 C9        	RET
 0287 0E09      PRMSG:	MVI	C,9		;BDOS PRINT STRING, TO THE $
 0289 C30500    	JMP	BDOS
                ;
 028C 70E8060000PKT:	DB	70H,0E8H,6,0,0,0 ;DEV, CMD, LENGTH, CHECKSUM, DESC
 0292 4E6574776FMNET:	DB	'Network:  $'
 029D 0D0A466972MVER:	DB	0DH,0AH,'Firmware: $'
 02AA 0D0A24    MEND:	DB	0DH,0AH,'$'
 02AD 4261642072MBAD:	DB	'Bad reply',0DH,0AH,'$'
 02B9 46756A694EMNAK:	DB	'FujiNet said NAK',0DH,0AH,'$'
 02CC 4E6F207265MTIME:	DB	'No reply',0DH,0AH,'$'
 02D7           OLDSP:	DS	2		;THE CCP'S SP
 02D9           REPLY:	DS	RMAX		;THE REPLY PACKET, UNESCAPED
 03A1           	DS	64
                STACK:
 03E1           	END	START
