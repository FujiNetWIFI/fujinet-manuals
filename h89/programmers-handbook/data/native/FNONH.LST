                                                  	HEATH ASM #104.06.00
                                                  	12-Oct-80  Page    1

                        00001   *	FNONH.ASM - ENABLE THE FUJINET CARD IN AN H89 (82C55 AT 320Q)
                        00002   *
                        00003   *	THE HDOS TWIN OF FNON.ASM, FOR HEATH'S ASM.  SETS THE 82C55
                        00004   *	TO MODE 2, BOOTS THE ESP32 FROM FLASH AND TURNS THE 74LVC245
                        00005   *	TOWARD THE H89.  LEAVES A CARD THAT IS ALREADY ON ALONE:
                        00006   *	WHATEVER SETS THE CARD UP LEAVES 245Q IN PORT B, WHICH A RESET
                        00007   *	OR ANOTHER MODE WORD CLEARS.  EN ALONE CAN'T TELL, AS AFTER A
                        00008   *	RESET THE 82C55'S BUS HOLD CAN PULL PC2 HIGH.
                        00009   *
                        00010   *	>SY1:ASM SY1:FNONH,SY1:FNONH=SY1:FNONH
                        00011   *	>SY1:FNONH
                        00012   *
                        00013   *	ASM.ABS, HOSDEF.ACM AND ASCII.ACM (FROM THE SOFTWARE TOOLS
                        00014   *	DISK) ARE ON SY1: WITH THIS FILE.
                        00015   *
                        00016   *	Copyright (C) 2026 Thomas Cherryhomes
                        00017   *	SPDX-License-Identifier: GPL-3.0-or-later
                        00018   *
   042.200              00019   	XTEXT	HOSDEF		HDOS SYSTEM CALLS: .PRINT, .EXIT
   000.207              00085   	XTEXT	ASCII		ENL: NEW LINE + 200Q, ENDS A LINE
                        00114   *
   000.320              00115   PORTA	EQU	320Q		D0H: 82C55 PORT A, THE BYTE PIPE
   000.321              00116   PORTB	EQU	321Q		UNWIRED: HOLDS MARK ONCE SET UP
   000.322              00117   PORTC	EQU	322Q		PC0 DIR, PC1 /OE (ESP32 IO0), PC2 EN
   000.323              00118   PCTRL	EQU	323Q		CONTROL WORD, PORT C BIT SET/RESET
   000.245              00119   MARK	EQU	245Q		0A5H, AS FUJINET-LIB LEAVES IT
                        00120   *
   042.200              00121   	ORG	42200A		WHERE HDOS LOADS A PROGRAM
                        00122   *
   042.200  333 321     00123   START	IN	PORTB
   042.202  376 245     00124   	CPI	MARK		MARK AND EN HIGH: ALREADY RUNNING
   042.204  302 216 042 00125   	JNZ	SETUP
   042.207  333 322     00126   	IN	PORTC
   042.211  346 004     00127   	ANI	004Q
   042.213  302 260 042 00128   	JNZ	ISON
   042.216  076 300     00129   SETUP	MVI	A,300Q		PORT A MODE 2, PC0-PC2 OUTPUTS
   042.220  323 323     00130   	OUT	PCTRL		(CLEARS PORT C, SO EN GOES LOW)
   042.222  076 006     00131   	MVI	A,006Q		EN=1, IO0=1 AT ONCE: A RUNNING ESP32
   042.224  323 322     00132   	OUT	PORTC		STAYS UP, ONE IN RESET BOOTS
   042.226  001 150 102 00133   	LXI	B,17000		KEEP IO0 HIGH WHILE IT STARTS, ~200 MS
   042.231  315 270 042 00134   	CALL	WAIT
   042.234  076 245     00135   	MVI	A,MARK		THE CARD IS SET UP
   042.236  323 321     00136   	OUT	PORTB
   042.240  333 320     00137   	IN	PORTA		DROP ANY BYTE LATCHED DURING RESET
   042.242  076 002     00138   	MVI	A,002Q		PC1=0: ENABLE THE 245
   042.244  323 323     00139   	OUT	PCTRL
   042.246  076 000     00140   	MVI	A,000Q		PC0=0: 245 DRIVES TOWARD THE H89
   042.250  323 323     00141   	OUT	PCTRL
   042.252  041 277 042 00142   	LXI	H,MSGON
   042.255  303 263 042 00143   	JMP	DONE
   042.260  041 317 042 00144   ISON	LXI	H,MSGRUN
   042.263  377 003     00145   DONE	SCALL	.PRINT		PRINT TO THE BYTE WITH BIT 7 SET
   042.265  257         00146   	XRA	A
   042.266  377 000     00147   	SCALL	.EXIT		BACK TO HDOS
                        00148   *
   042.270  013         00149   WAIT	DCX	B		ABOUT 12 US A PASS AT 2 MHZ
   042.271  170         00150   	MOV	A,B
                                                  	HEATH ASM #104.06.00
                                                  	12-Oct-80  Page    2

   042.272  261         00151   	ORA	C
   042.273  302 270 042 00152   	JNZ	WAIT
   042.276  311         00153   	RET
                        00154   *
   042.277  106 125 112 00155   MSGON	DB	'FUJINET ENABLED',ENL
   042.317  106 125 112 00156   MSGRUN	DB	'FUJINET ALREADY ON',ENL
                        00157   *
   042.342  000         00158   	END	START


