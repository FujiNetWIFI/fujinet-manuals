                        00001   *	FNVERH.ASM - ASK THE H89 FUJINET FOR ITS FIRMWARE VERSION
                        00002   *
                        00003   *	THE HDOS TWIN OF FNVER.ASM, FOR HEATH'S ASM.  SETS UP THE
                        00004   *	CARD'S 82C55, SENDS FUJI_GET_ADAPTERCONFIG (DEVICE 160Q,
                        00005   *	COMMAND 350Q) IN A SLIP FRAME, CHECKS THE REPLY AND PRINTS
                        00006   *	THE NETWORK NAME AND FIRMWARE VERSION.  PURE 8080.
                        00007   *
                        00008   *	>SY1:ASM SY1:FNVERH,SY1:FNVERH=SY1:FNVERH
                        00009   *	>SY1:FNVERH
                        00010   *
                        00011   *	ASM.ABS, HOSDEF.ACM AND ASCII.ACM (FROM THE SOFTWARE TOOLS
                        00012   *	DISK) ARE ON SY1: WITH THIS FILE.
                        00013   *
                        00014   *	Copyright (C) 2026 Thomas Cherryhomes
                        00015   *	SPDX-License-Identifier: GPL-3.0-or-later
                        00016   *
   042.200              00017   	XTEXT	HOSDEF		HDOS SYSTEM CALLS
   000.207              00083   	XTEXT	ASCII		NL, ENL
                        00112   *
   000.320              00113   PORTA	EQU	320Q		D0H: 82C55 PORT A, THE BYTE PIPE
   000.322              00114   PORTC	EQU	322Q		STATUS IN, PC0-PC2 OUT
   000.323              00115   PCTRL	EQU	323Q		CONTROL WORD, PORT C BIT SET/RESET
   000.200              00116   OBF	EQU	200Q		PC7 /OBF: 1 = OUR LAST BYTE WAS TAKEN
   000.040              00117   IBF	EQU	040Q		PC5 IBF: 1 = A BYTE WAITS FOR US
   040.033              00118   TICKS	EQU	40033A		HDOS 2 MS CLOCK (.TICCNT IN MTR.ACM)
   035.114              00119   TMAX	EQU	7500		GIVE UP AFTER 15 S (7500 TICKS)
   000.300              00120   SLEND	EQU	300Q		SLIP END: FRAMES A PACKET
   000.333              00121   SLESC	EQU	333Q		SLIP ESC
   000.334              00122   ESCEND	EQU	334Q		333 334 STANDS FOR A 300
   000.335              00123   ESCESC	EQU	335Q		333 335 STANDS FOR A 333
   000.310              00124   RMAX	EQU	200		REPLY BUFFER SIZE
