# The book's bench: its own ports, clear of the other rigs (bench/ports.sh
# checks them before anything starts).
FNPC_DIR=${FNPC_DIR:-$HOME/Workspace/fnpc-studio2-book}
BOIP_PORT=${BOIP_PORT:-9973}       # fujinet-pc BoIP: MAME's FUJINET_TCP
WEB_PORT=${WEB_PORT:-8073}         # fujinet-pc web UI
HTTP_PORT=${HTTP_PORT:-8766}       # the HTTP fixture (listings/fixtures)
NC_PORT=${NC_PORT:-8767}           # the netcat line server
BS_PORT=${BS_PORT:-8771}           # Battleship server
FCS_PORT=${FCS_PORT:-8772}         # 5 Card Stud server
